# ─── Database ──────────────────────────────────────────────────────
# Neon pooled connection string (or any Postgres URL with sslmode=require).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Same as DATABASE_URL — used by Prisma CLI for migrations & studio.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional IPv4 override when Node/pg times out on DNS but a specific Neon IP works.
# Used by app runtime (buildPostgresConfig) and Prisma CLI (prisma.config.ts → hostaddr).
DATABASE_HOSTADDR=""

# ─── App secrets (REQUIRED) ────────────────────────────────────────
# Signs the session-claim JWT cookie used by proxy.ts for fast auth checks.
# Generate with:  openssl rand -base64 32
AUTH_SECRET=""

# Required by Next.js 16 to encrypt Server Action payloads (login, register,
# forgot-password, etc.). Without it, server actions fail in production.
# Generate with:  openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# Bearer token for the /api/cron/reminders endpoint.
CRON_SECRET=""

# ─── Public app URL ────────────────────────────────────────────────
# Used to build absolute URLs (email verification, password reset,
# Google OAuth redirect_uri, etc.). MUST match your production domain
# exactly, including https.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Google OAuth ──────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Add an Authorized redirect URI of:
#   <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
# e.g. http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── AI (Groq) ─────────────────────────────────────────────────────
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
# Vision model for image recognition tasks (medication identification, etc.)
GROQ_VISION_MODEL="llama-3.2-90b-vision-preview"

# ─── Email (Resend) ────────────────────────────────────────────────
EMAIL_FROM="Aether Pharmacy <support@gtss.software>"
RESEND_API_KEY=""

# ─── SMS (Twilio) ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""

# ─── WhatsApp Cloud API ────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ─── Webhooks ──────────────────────────────────────────────────────
DELIVERY_WEBHOOK_SECRET=""

# ─── Firebase Cloud Messaging (push notifications) ─────────────────
# Public client config (safe to expose to the browser).
# Get these from Firebase Console → Project settings → General → Your apps → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# Server-side service-account credentials used by firebase-admin to send pushes.
# Either paste the full JSON OR set FIREBASE_PROJECT_ID + FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY.
# Generate at Firebase Console → Project settings → Service accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ─── Support contact (used in email footers) ──────────────────────
# Override the default support email/phone shown in every outbound email.
SUPPORT_EMAIL="support@gtss.software"
SUPPORT_PHONE="0790670542"

# ─── Daraja (M-Pesa) payment integration ──────────────────────────
# Test mode is sandbox by default. Set DARAJA_ENV=production to go live.
# Get credentials at https://developer.safaricom.co.ke
DARAJA_ENV="sandbox"
DARAJA_CONSUMER_KEY=""
DARAJA_CONSUMER_SECRET=""
DARAJA_SHORTCODE=""
DARAJA_PASSKEY=""
DARAJA_CALLBACK_URL="https://yourdomain.com/api/payments/daraja/callback"

# ─── POS integration ──────────────────────────────────────────────
# Shared secret for the /api/integrations/pos sync endpoint.
# Contact 0790670542 for integration setup.
POS_API_KEY=""

# ─── Loyalty automation ───────────────────────────────────────────
# Points per currency unit spent on orders. Default: 1 point per KES 100.
LOYALTY_SPEND_MULTIPLIER="0.01"

# ─── Localization ─────────────────────────────────────────────────
# Timezone for all date/time rendering (Asia/Shanghai, Africa/Nairobi, etc.)
TIMEZONE="Africa/Nairobi"
LOCALE="en-KE"
