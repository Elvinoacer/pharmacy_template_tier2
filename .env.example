# ─── Database ──────────────────────────────────────────────────────
# Neon pooled connection string (or any Postgres URL with sslmode=require).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Same as DATABASE_URL — used by Prisma CLI for migrations & studio.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional IPv4 override when Node/pg times out on DNS but a specific Neon IP works.
# Used by app runtime (buildPostgresConfig) and Prisma CLI (prisma.config.ts → hostaddr).
DATABASE_HOSTADDR=""

# ─── App secrets (REQUIRED) ────────────────────────────────────────
# Signs the session-claim JWT cookie used by proxy.ts for fast auth checks.
# Generate with:  openssl rand -base64 32
AUTH_SECRET=""

# Required by Next.js 16 to encrypt Server Action payloads (login, register,
# forgot-password, etc.). Without it, server actions fail in production.
# Generate with:  openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# Bearer token for the /api/cron/reminders endpoint.
CRON_SECRET=""

# ─── Public app URL ────────────────────────────────────────────────
# Used to build absolute URLs (email verification, password reset,
# Google OAuth redirect_uri, etc.). MUST match your production domain
# exactly, including https.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Google OAuth ──────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Add an Authorized redirect URI of:
#   <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
# e.g. http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── AI (Groq) ─────────────────────────────────────────────────────
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# ─── Email (Resend) ────────────────────────────────────────────────
EMAIL_FROM="Aether Pharmacy <support@gtss.software>"
RESEND_API_KEY=""

# ─── SMS (Twilio) ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""

# ─── WhatsApp Cloud API ────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ─── Webhooks ──────────────────────────────────────────────────────
DELIVERY_WEBHOOK_SECRET=""
