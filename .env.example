# =============================================================================
# Afyvia Pharmacy Network — environment
# =============================================================================
# Platform-level secrets live here. Per-pharmacy operational credentials are
# encrypted at rest and configured through the tenant integration settings.
# =============================================================================

# ─── Database ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DATABASE_HOSTADDR=""

# ─── Application/session secrets ──────────────────────────────────
AUTH_SECRET=""
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
CRON_SECRET=""
INTEGRATION_SECRET=""
HEALTH_MEDIA_SIGNING_SECRET=""
REFILL_TRACKING_SECRET=""
AI_CLINICAL_CONTEXT_ENABLED="false"
AI_CONVERSATION_RETENTION_DAYS="90"
SYMPTOM_MEDIA_RETENTION_DAYS="30"

# ─── Public app URL ────────────────────────────────────────────────
# Production payment callbacks require an HTTPS public origin.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Platform Branding ────────────────────────────────────────────
PLATFORM_BRAND_NAME="Afyvia Pharmacy Network"

# ─── Google OAuth ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── AI (Groq) ────────────────────────────────────────────────────
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
GROQ_VISION_MODEL="qwen/qwen3.8-27b"

# ─── Email (Resend) ───────────────────────────────────────────────
EMAIL_FROM="Afyvia <support@gtss.software>"
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""

# ─── SMS (Twilio) ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""

# ─── WhatsApp Cloud API ───────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""

# ─── Webhooks ─────────────────────────────────────────────────────
DELIVERY_WEBHOOK_SECRET=""

# ─── Firebase Cloud Messaging ─────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ─── Support contact ───────────────────────────────────────────────
SUPPORT_EMAIL="support@gtss.software"
SUPPORT_PHONE="0790670542"

# ─── Safaricom Daraja — ALL payment collection ────────────────────
# Daraja is the only payment integration in Afyvia.
# It covers customer/order M-PESA, pharmacy verification/platform invoices,
# STK Push, payment status reconciliation, and M-PESA Ratiba subscriptions.
# Sandbox uses Safaricom's standard sandbox Lipa na M-PESA shortcode/passkey.
DARAJA_ENV="sandbox"
DARAJA_CONSUMER_KEY=""
DARAJA_CONSUMER_SECRET=""
DARAJA_SHORTCODE=""
DARAJA_PASSKEY=""
DARAJA_TRANSACTION_TYPE="CustomerPayBillOnline"
DARAJA_CALLBACK_URL="https://yourdomain.com/api/payments/daraja/callback"
NEXT_PUBLIC_DARAJA_ENABLED="true"

# ─── M-PESA Ratiba — automatic monthly pharmacy subscription ──────
# Ratiba is a Safaricom standing-order product and must be provisioned for the
# production shortcode before enabling it. Until then Aether remains Daraja-only
# and collects monthly invoices through M-PESA STK Push.
DARAJA_RATIBA_ENABLED="false"
DARAJA_RATIBA_CALLBACK_URL="https://yourdomain.com/api/payments/daraja/ratiba/callback"
DARAJA_RATIBA_WEBHOOK_SECRET="replace-with-a-long-random-secret"
# Current Ratiba monthly frequency code. Keep configurable in case Safaricom
# assigns a different value to a provisioned production product profile.
DARAJA_RATIBA_MONTHLY_FREQUENCY="5"
DARAJA_RATIBA_TRANSACTION_TYPE="Standing Order Pay Bill External Third Party"
DARAJA_RATIBA_RECEIVER_IDENTIFIER_TYPE="4"

# ─── Daraja command APIs (status/reversal/C2B) ────────────────────
# Production Transaction Status and Reversal operations require Safaricom's
# initiator/security-credential provisioning. These values are server-only.
DARAJA_INITIATOR_NAME=""
DARAJA_SECURITY_CREDENTIAL=""
DARAJA_RESULT_URL="https://yourdomain.com/api/payments/daraja/result"
DARAJA_TIMEOUT_URL="https://yourdomain.com/api/payments/daraja/timeout"
DARAJA_C2B_CONFIRMATION_URL="https://yourdomain.com/api/payments/daraja/c2b/confirmation"
DARAJA_C2B_VALIDATION_URL="https://yourdomain.com/api/payments/daraja/c2b/validation"

# ─── POS integration fallback ─────────────────────────────────────
POS_API_KEY=""

# ─── Loyalty automation ───────────────────────────────────────────
LOYALTY_SPEND_MULTIPLIER="0.01"

# ─── Caregiver invitation cooldown ────────────────────────────────
CAREGIVER_INVITE_COOLDOWN_SECONDS="60"
NEXT_PUBLIC_CAREGIVER_INVITE_COOLDOWN="60"

# ─── Demo credentials display ─────────────────────────────────────
SHOW_DEMO_CREDENTIALS="false"

# ─── Localization ─────────────────────────────────────────────────
TIMEZONE="Africa/Nairobi"
LOCALE="en-KE"

# ─── Cloudflare R2 — public storefront/admin imagery ──────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
NEXT_PUBLIC_R2_PUBLIC_URL=""
R2_ENDPOINT=""

# ─── Cloudflare R2 — PRIVATE health media ─────────────────────────
R2_PRIVATE_BUCKET_NAME=""
