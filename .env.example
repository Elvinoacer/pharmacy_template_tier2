# ─── Support contact ───────────────────────────────────────────────
SUPPORT_EMAIL="support@gtss.software"
SUPPORT_PHONE="0790670542"

# ─── Safaricom Daraja — customer/order M-Pesa only ────────────────
# Daraja may still be used for customer/pharmacy commerce elsewhere in Aether.
# It is NOT used for the pharmacy's platform subscription.
DARAJA_ENV="sandbox"
DARAJA_CONSUMER_KEY=""
DARAJA_CONSUMER_SECRET=""
DARAJA_SHORTCODE=""
DARAJA_PASSKEY=""
DARAJA_CALLBACK_URL="https://yourdomain.com/api/payments/daraja/callback"
NEXT_PUBLIC_DARAJA_ENABLED="true"

# ─── Paystack — platform card checkout + recurring subscriptions ──
# Paystack is the platform billing provider for pharmacies:
#   • KES 100 verification and other one-time platform invoices use hosted card checkout.
#   • KES 500/month service uses Paystack Subscriptions and automatically charges
#     the authorized card every month until the subscription is cancelled.
#
# Dashboard setup:
# 1) Create a MONTHLY plan for exactly KES 500 and copy its PLN_... code below.
#    Do not set an invoice limit if you want the subscription to continue until cancelled.
# 2) Configure the webhook URL:
#      https://yourdomain.com/api/payments/paystack/webhook
# 3) Use sk_test_... while testing. Replace it with sk_live_... only after your
#    Paystack business is activated for live payments.
#
# The secret key is server-only. Never expose it through NEXT_PUBLIC_*.
PAYSTACK_SECRET_KEY=""
PAYSTACK_SUBSCRIPTION_PLAN_CODE=""

# Browser return route is handled automatically by the app:
#   https://yourdomain.com/api/payments/paystack/callback

# ─── POS integration fallback ─────────────────────────────────────
POS_API_KEY=""

# ─── Loyalty automation ───────────────────────────────────────────
LOYALTY_SPEND_MULTIPLIER="0.01"

# ─── Caregiver invitation cooldown ────────────────────────────────
CAREGIVER_INVITE_COOLDOWN_SECONDS="60"
NEXT_PUBLIC_CAREGIVER_INVITE_COOLDOWN="60"

# ─── Demo credentials display ─────────────────────────────────────
SHOW_DEMO_CREDENTIALS="false"

# ─── Localization ─────────────────────────────────────────────────
TIMEZONE="Africa/Nairobi"
LOCALE="en-KE"

# ─── Cloudflare R2 — public storefront/admin imagery ──────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
NEXT_PUBLIC_R2_PUBLIC_URL=""
R2_ENDPOINT=""

# ─── Cloudflare R2 — PRIVATE health media ─────────────────────────
R2_PRIVATE_BUCKET_NAME=""
