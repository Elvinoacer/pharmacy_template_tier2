AI_CONVERSATION_RETENTION_DAYS="90"
SYMPTOM_MEDIA_RETENTION_DAYS="30"

# ─── Public app URL ────────────────────────────────────────────────
# Required for OAuth, notifications and hosted-payment callbacks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Platform Branding ────────────────────────────────────────────
PLATFORM_BRAND_NAME="Aether Pharmacy Network"

# ─── Google OAuth ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

