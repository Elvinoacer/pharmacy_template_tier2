# =============================================================================
# Aether Pharmacy Network — environment
# =============================================================================
# Platform-level secrets live here. Per-pharmacy operational credentials are
# encrypted at rest and configured through the tenant integration settings.
# =============================================================================

# ─── Database ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DATABASE_HOSTADDR=""

# ─── Application/session secrets ──────────────────────────────────
# Generate independently; do not reuse these values for integrations/media.
AUTH_SECRET=""
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
CRON_SECRET=""

# Dedicated AES-GCM key for tenant integration credentials. REQUIRED for new
# encrypted credentials. Use 32+ random characters. Do not reuse AUTH_SECRET.
INTEGRATION_SECRET=""

# Dedicated HMAC key for short-lived private health-media access tokens.
# If omitted, the application has a compatibility fallback to AUTH_SECRET, but
# production deployments should always set this independently.
HEALTH_MEDIA_SIGNING_SECRET=""

# Detailed caregiver clinical context is privacy-first and disabled by default.
# Enable only after the applicable processor/privacy governance is in place.
AI_CLINICAL_CONTEXT_ENABLED="false"

# ─── Public app URL ────────────────────────────────────────────────
# Canonical application URL used for absolute links and OAuth redirects.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Compatibility alias for legacy metadata code. Keep identical while older
# call sites are migrated.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Google OAuth ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── AI (Groq) ────────────────────────────────────────────────────
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
GROQ_VISION_MODEL="qwen/qwen3.6-27b"

# ─── Email (Resend) ───────────────────────────────────────────────
EMAIL_FROM="Aether <support@gtss.software>"
RESEND_API_KEY=""

# ─── SMS (Twilio) ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""

# ─── WhatsApp Cloud API ───────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ─── Webhooks ─────────────────────────────────────────────────────
DELIVERY_WEBHOOK_SECRET=""

# ─── Firebase Cloud Messaging ─────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ─── Support contact ───────────────────────────────────────────────
SUPPORT_EMAIL="support@gtss.software"
SUPPORT_PHONE="0790670542"

# ─── Daraja (M-Pesa) platform fallback ────────────────────────────
DARAJA_ENV="sandbox"
DARAJA_CONSUMER_KEY=""
DARAJA_CONSUMER_SECRET=""
DARAJA_SHORTCODE=""
DARAJA_PASSKEY=""
DARAJA_CALLBACK_URL="https://yourdomain.com/api/payments/daraja/callback"

# ─── POS integration fallback ─────────────────────────────────────
POS_API_KEY=""

# ─── Localization ─────────────────────────────────────────────────
TIMEZONE="Africa/Nairobi"
LOCALE="en-KE"

# ─── Cloudflare R2 — public storefront/admin imagery ──────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
NEXT_PUBLIC_R2_PUBLIC_URL=""
R2_ENDPOINT=""

# ─── Cloudflare R2 — PRIVATE health media ─────────────────────────
# MUST be a private bucket with no public r2.dev/custom-domain exposure.
# Symptom images are stored here as r2-private:// references and served only
# through short-lived application-signed media tokens.
R2_PRIVATE_BUCKET_NAME=""
