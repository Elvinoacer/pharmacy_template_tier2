# =============================================================================
# Aether Pharmacy Network — environment
# =============================================================================
# Platform-level secrets live here (one set for the whole network).
# Per-pharmacy secrets (M-Pesa shortcode, Twilio sender, WhatsApp number, POS
# key, timezone, loyalty multiplier) live in the `pharmacy_integrations` table
# and are edited from /admin/settings — never as extra env vars per tenant.
# =============================================================================

# ─── Database (platform) ───────────────────────────────────────────
# Neon pooled connection string (or any Postgres URL with sslmode=require).
# Shared database. Tenant isolation is row-level via pharmacy_id.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Same as DATABASE_URL — used by Prisma CLI for migrations & studio.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional IPv4 override when Node/pg times out on DNS but a specific Neon IP works.
# Used by app runtime (buildPostgresConfig) and Prisma CLI (prisma.config.ts → hostaddr).
DATABASE_HOSTADDR=""

# ─── App secrets (REQUIRED, platform) ──────────────────────────────
# Signs the session-claim JWT cookie used by proxy.ts for fast auth checks.
# Generate with:  openssl rand -base64 32
AUTH_SECRET=""

# Required by Next.js 16 to encrypt Server Action payloads (login, register,
# onboard, etc.). Without it, server actions fail in production.
# Generate with:  openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# Bearer token for the /api/cron/* endpoints (reminders, inventory, loyalty).
CRON_SECRET=""

# ─── Public app URL (platform) ─────────────────────────────────────
# Used to build absolute URLs (email verification, password reset,
# Google OAuth redirect_uri, etc.). MUST match your production domain
# exactly, including https.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Google OAuth (platform identity) ──────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Add an Authorized redirect URI of:
#   <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── AI (Groq) — platform ──────────────────────────────────────────
GROQ_API_KEY=""
# Production text model (Llama 3.1/3.3 IDs were shut down 16 Aug 2026).
GROQ_MODEL="openai/gpt-oss-20b"
# Vision model for medicine pack photo search + symptom image turns
GROQ_VISION_MODEL="qwen/qwen3.6-27b"

# ─── Email (Resend) — platform fallback ────────────────────────────
# Pharmacies may override From / support addresses in PharmacyIntegration.
EMAIL_FROM="Aether <support@gtss.software>"
RESEND_API_KEY=""

# ─── SMS (Twilio) — platform fallback ──────────────────────────────
# Per-pharmacy From numbers live in pharmacy_integrations.twilio_sms_from.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""

# ─── WhatsApp Cloud API — platform fallback ────────────────────────
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ─── Webhooks (platform) ───────────────────────────────────────────
DELIVERY_WEBHOOK_SECRET=""

# ─── Firebase Cloud Messaging (platform) ───────────────────────────
# Public client config (safe to expose to the browser).
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# Server-side service-account credentials used by firebase-admin to send pushes.
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ─── Support contact (platform fallback) ───────────────────────────
SUPPORT_EMAIL="support@gtss.software"
SUPPORT_PHONE="0790670542"

# ─── Daraja (M-Pesa) — platform fallback ──────────────────────────
# Per-pharmacy shortcodes/keys belong in pharmacy_integrations (encrypted).
# These env values are used only when a tenant has not configured its own.
DARAJA_ENV="sandbox"
DARAJA_CONSUMER_KEY=""
DARAJA_CONSUMER_SECRET=""
DARAJA_SHORTCODE=""
DARAJA_PASSKEY=""
DARAJA_CALLBACK_URL="https://yourdomain.com/api/payments/daraja/callback"

# ─── POS integration — platform fallback ──────────────────────────
# Per-pharmacy hashed keys live on pharmacy_integrations.pos_api_key_hash.
POS_API_KEY=""

# ─── Loyalty automation — platform default ────────────────────────
# Overridden per pharmacy via pharmacy_integrations.loyalty_spend_multiplier.
LOYALTY_SPEND_MULTIPLIER="0.01"

# ─── Localization — platform default ──────────────────────────────
# Overridden per pharmacy via pharmacy_integrations.timezone / locale.
TIMEZONE="Africa/Nairobi"
LOCALE="en-KE"

# ─── Cloudflare R2 (image uploads) — platform ─────────────────────
# Shared object storage. Keys are prefixed by pharmacy id in application code.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Public base URL, e.g. https://pub-xxxxx.r2.dev  OR  https://images.yourdomain.com
R2_PUBLIC_URL=""
NEXT_PUBLIC_R2_PUBLIC_URL=""
# Optional — defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=""
