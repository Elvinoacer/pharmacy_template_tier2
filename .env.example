# =============================================================================
# Aether Pharmacy Network — environment
# =============================================================================
# Platform-level secrets live here. Per-pharmacy operational credentials are
# encrypted at rest and configured through the tenant integration settings.
# =============================================================================

# ─── Database ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DATABASE_HOSTADDR=""

# ─── Application/session secrets ──────────────────────────────────
# Generate independently; do not reuse these values for integrations/media.
AUTH_SECRET=""
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
CRON_SECRET=""

# Dedicated AES-GCM key for tenant integration credentials. REQUIRED for new
# encrypted credentials. Use 32+ random characters. Do not reuse AUTH_SECRET.
INTEGRATION_SECRET=""

# Dedicated HMAC key for short-lived private health-media access tokens.
# REQUIRED in production and must not reuse AUTH_SECRET.
HEALTH_MEDIA_SIGNING_SECRET=""

# Dedicated HMAC key for customer refill tracking tokens.
REFILL_TRACKING_SECRET=""

# Detailed caregiver clinical context is privacy-first and disabled by default.
# Enable only after the applicable processor/privacy governance is in place.
AI_CLINICAL_CONTEXT_ENABLED="false"

# Data-retention policy. Tune to the pharmacy/network's approved policy.
AI_CONVERSATION_RETENTION_DAYS="90"
SYMPTOM_MEDIA_RETENTION_DAYS="30"

# ─── Public app URL ────────────────────────────────────────────────
# The single canonical application URL used for metadata, absolute links,
# OAuth redirects, notifications, and payment redirects.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Platform Branding ────────────────────────────────────────────
PLATFORM_BRAND_NAME="Aether Pharmacy Network"

# ─── Google OAuth ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── AI (Groq) ────────────────────────────────────────────────────
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
GROQ_VISION_MODEL="qwen/qwen3.6-27b"

# ─── Email (Resend) ───────────────────────────────────────────────
EMAIL_FROM="Aether <support@gtss.software>"
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""

# ─── SMS (Twilio) ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""

# ─── WhatsApp Cloud API ───────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""

# ─── Webhooks ─────────────────────────────────────────────────────
DELIVERY_WEBHOOK_SECRET=""

# ─── Firebase Cloud Messaging ─────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ─── Support contact ───────────────────────────────────────────────
SUPPORT_EMAIL="support@gtss.software"
SUPPORT_PHONE="0790670542"

# ─── Safaricom Daraja — customer/order M-Pesa only ────────────────
# Daraja may still be used for pharmacy/customer commerce elsewhere in Aether.
# It is NOT used for the pharmacy's KES 500 platform subscription anymore.
# Get credentials at https://developer.safaricom.co.ke
DARAJA_ENV="sandbox"
DARAJA_CONSUMER_KEY=""
DARAJA_CONSUMER_SECRET=""
DARAJA_SHORTCODE=""
DARAJA_PASSKEY=""
DARAJA_CALLBACK_URL="https://yourdomain.com/api/payments/daraja/callback"
NEXT_PUBLIC_DARAJA_ENABLED="true"

# ─── IntaSend — platform card billing + automatic subscriptions ──
# Aether platform billing is card-first:
#   • KES 100 verification / other one-time platform invoices use hosted card checkout.
#   • KES 500 monthly service uses IntaSend Subscriptions (CARD-PAYMENT) and is
#     charged automatically after the pharmacy authorizes its card once.
#
# IntaSend dashboard setup:
# 1) Create a subscription plan with:
#      currency=KES, amount=500, frequency=1, frequency_unit=M
#    Choose the billing_cycles policy you want in IntaSend, then copy its plan_id
#    into INTASEND_SUBSCRIPTION_PLAN_ID below.
# 2) Configure this webhook URL in IntaSend:
#      https://yourdomain.com/api/payments/intasend/callback
# 3) Set a strong webhook challenge in the IntaSend dashboard and copy the exact
#    same value into INTASEND_WEBHOOK_CHALLENGE.
# 4) Sandbox keys must be used with INTASEND_ENV=sandbox; live keys with production.
#
# Security: INTASEND_SECRET_KEY is server-only. Never expose it via NEXT_PUBLIC_*.
INTASEND_ENV="sandbox"
INTASEND_PUBLISHABLE_KEY=""
INTASEND_SECRET_KEY=""
INTASEND_SUBSCRIPTION_PLAN_ID=""
INTASEND_WEBHOOK_CHALLENGE=""

# ─── POS integration fallback ─────────────────────────────────────
POS_API_KEY=""

# ─── Loyalty automation ───────────────────────────────────────────
# Points per currency unit spent on orders. Default: 1 point per KES 100 (0.01).
LOYALTY_SPEND_MULTIPLIER="0.01"

# ─── Caregiver invitation cooldown ────────────────────────────────
# Cooldown period in seconds between caregiver invitation resends. Default: 60.
CAREGIVER_INVITE_COOLDOWN_SECONDS="60"
NEXT_PUBLIC_CAREGIVER_INVITE_COOLDOWN="60"

# ─── Demo credentials display ─────────────────────────────────────
SHOW_DEMO_CREDENTIALS="false"

# ─── Localization ─────────────────────────────────────────────────
TIMEZONE="Africa/Nairobi"
LOCALE="en-KE"

# ─── Cloudflare R2 — public storefront/admin imagery ──────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
NEXT_PUBLIC_R2_PUBLIC_URL=""
R2_ENDPOINT=""

# ─── Cloudflare R2 — PRIVATE health media ─────────────────────────
# MUST be a private bucket with no public r2.dev/custom-domain exposure.
# Symptom images are stored here as r2-private:// references and served only
# through short-lived application-signed media tokens.
R2_PRIVATE_BUCKET_NAME=""
