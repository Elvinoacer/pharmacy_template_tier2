// Tier 2 — Customer Engagement Platform
// Prisma 7 schema for Aether Pharmacy

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ─────────────────────────────────────────────────────

enum UserRole {
  customer
  caregiver
  pharmacist
  staff
  manager
}

enum UserStatus {
  active
  inactive
  suspended
}

enum Gender {
  female
  male
  other
  prefer_not_to_say
}

enum CommChannel {
  email
  sms
  whatsapp
  phone
}

enum CaregiverStatus {
  active
  revoked
}

enum PrescriptionStatus {
  active
  on_hold
  expired
  discontinued
}

enum PrescriptionIntakeChannel {
  physical_paper
  whatsapp
  email
  patient_upload
  doctor_referral
  hospital_system
  electronic_prescription
  phone_communication
  in_person_consultation
}

enum PrescriptionLifecycleStatus {
  received
  under_review
  approved
  partially_fulfilled
  ready
  dispatched
  completed
  on_hold
  rejected
  cancelled
}

enum ClarificationStatus {
  none
  needed
  contacted
  clarified
  resolved
}

enum RefillStatus {
  submitted
  under_review
  approved
  preparing
  ready_for_pickup
  collected
  cancelled
}

enum PickupPreference {
  pickup
  delivery
}

enum RefillSource {
  website
  portal
  ai
  phone
  whatsapp
  staff
}

/// Billing unit for pharmaceutical items (audit §14).
/// Captures whether quantity refers to tablets, bottles, packs, etc.
enum BillingUnit {
  TABLET
  CAPSULE
  BOTTLE
  BOX
  PACK
  STRIP
  AMPOULE
  ML
  UNIT
}

enum MessageChannel {
  email
  sms
  whatsapp
  portal
  ai
  system
}

enum ConversationChannel {
  email
  sms
  whatsapp
  portal
  ai
}

enum ConversationStatus {
  open
  pending
  resolved
  closed
}

enum MessageDirection {
  inbound
  outbound
}

enum SenderType {
  customer
  staff
  system
  ai
}

enum MessageStatus {
  draft
  scheduled
  sent
  delivered
  failed
  opened
  clicked
  replied
}

enum NotificationChannel {
  email
  sms
  whatsapp
  push
  in_app
}

enum NotificationStatus {
  pending
  sent
  delivered
  failed
  opened
  clicked
}

enum ReminderType {
  refill
  pickup
  follow_up
  wellness
  birthday
  custom
  medication_dose
}

enum ReminderStatus {
  scheduled
  sent
  cancelled
  failed
  answered
  escalated
}

enum CampaignChannel {
  email
  sms
  whatsapp
  multi
}

enum CampaignStatus {
  draft
  scheduled
  sending
  sent
  cancelled
}

enum LoyaltyTier {
  bronze
  silver
  gold
  platinum
}

enum LoyaltyTxType {
  earn
  redeem
  adjust
  referral
  bonus
}

enum DiscountType {
  percent
  fixed
  points
}

enum EnquiryType {
  general
  product_availability
  delivery
  contact
  careers
  other
}

enum EnquiryStatus {
  new
  in_progress
  resolved
  closed
}

enum FeedbackType {
  review
  suggestion
  complaint
  satisfaction
}

enum FeedbackStatus {
  new
  reviewed
  responded
  archived
}

enum AiChannel {
  website
  portal
  whatsapp
}


// ── Multi-tenancy (platform + pharmacies) ─────────────────────

enum PharmacyStatus {
  draft
  submitted
  under_review
  needs_info
  approved
  active
  suspended
  rejected
}

enum PharmacyMemberRole {
  owner
  manager
  pharmacist
  staff
}

enum PharmacyMemberStatus {
  invited
  active
  suspended
}

/// A tenant on the Aether network. One row per pharmacy business.
model Pharmacy {
  id                 String         @id @default(uuid()) @db.Uuid
  /// Public URL key: /p/{slug}
  slug               String         @unique
  name               String
  legalName          String?        @map("legal_name")
  tagline            String?
  description        String?
  licenseNumber      String?        @map("license_number")
  licenseDocumentUrl String?        @map("license_document_url")
  ppbPremisesNumber  String?        @map("ppb_premises_number")
  kraPin             String?        @map("kra_pin")
  status             PharmacyStatus @default(draft)
  /// When true, appears in the public marketplace (requires status=active).
  listed             Boolean        @default(false)
  featured           Boolean        @default(false)
  /// Super-admin review
  verificationNotes  String?        @map("verification_notes")
  rejectionReason    String?        @map("rejection_reason")
  verifiedAt         DateTime?      @map("verified_at")
  verifiedById       String?        @map("verified_by") @db.Uuid
  submittedAt        DateTime?      @map("submitted_at")
  goLiveAt           DateTime?      @map("go_live_at")
  setupCompletedAt   DateTime?      @map("setup_completed_at")
  ownerUserId        String?        @map("owner_user_id") @db.Uuid
  /// Contact (copied into PharmacySettings on approval; kept here for directory cards)
  email              String?
  phone              String?
  whatsapp           String?
  city               String?
  county             String?
  country            String         @default("Kenya")
  latitude           Float?
  longitude          Float?
  logoUrl            String?        @map("logo_url")
  coverImageUrl      String?        @map("cover_image_url")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  owner              User?          @relation("PharmacyOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  verifiedBy         User?          @relation("PharmacyVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  memberships        PharmacyMembership[]
  customers          CustomerPharmacy[]
  integrations       PharmacyIntegration?
  onboardingEvents   PharmacyOnboardingEvent[]

  inventory                PharmacyInventory[]
  medicationCategories     MedicationCategory[]
  settings                 PharmacySettings?
  orders                   Order[]
  prescriptions            Prescription[]
  refillRequests           RefillRequest[]
  segments                 Segment[]
  conversations            Conversation[]
  campaigns                Campaign[]
  loyaltyAccounts          LoyaltyAccount[]
  coupons                  Coupon[]
  enquiries                Enquiry[]
  feedback                 Feedback[]
  knowledgeArticles        KnowledgeArticle[]
  aiConversations          AiConversation[]
  auditLogs                AuditLog[]
  customerNotes            CustomerNote[]
  timelineEvents           TimelineEvent[]
  messageTemplates         MessageTemplate[]
  notifications            Notification[]
  reminders                Reminder[]
  loyaltyRules             LoyaltyRule[]
  services                 PharmacyService[]
  serviceBookings          ServiceBooking[]
  adminNotifications       AdminNotification[]
  symptomSessions          SymptomSession[]
  payments                 Payment[]
  stockMovements           StockMovement[]
  cashierSessions          CashierSession[]
  screenings               HealthScreeningRecord[]
  referrals                ClinicalReferral[]
  immunizationPolicy       PharmacyImmunizationPolicy?
  vaccineProducts          VaccineProduct[]
  immunizerCredentials     ImmunizerCredential[]
  immunizationAppointments ImmunizationAppointment[]
  counsellingSessions      PreventiveCounsellingSession[]
  publicHealthCampaigns    PublicHealthCampaign[]
  medicationSchedules      MedicationSchedule[]
  prescriptionFills        PrescriptionFill[]
  inventoryReservations    InventoryReservation[]
  refunds                  Refund[]
  priceHistory             MedicationPriceHistory[]
  commerceEvents           CommerceEvent[]

  @@index([status])
  @@index([listed, featured])
  @@index([city])
  @@index([county])
  @@map("pharmacies")
}

model PharmacyMembership {
  id          String               @id @default(uuid()) @db.Uuid
  pharmacyId  String               @map("pharmacy_id") @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  role        PharmacyMemberRole   @default(staff)
  status      PharmacyMemberStatus @default(active)
  invitedById String?              @map("invited_by") @db.Uuid
  invitedAt   DateTime?            @map("invited_at")
  acceptedAt  DateTime?            @map("accepted_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pharmacyId, userId])
  @@index([userId])
  @@index([pharmacyId, status])
  @@map("pharmacy_memberships")
}

/// A customer's relationship with a pharmacy (orders, prescriptions, loyalty).
model CustomerPharmacy {
  customerId  String   @map("customer_id") @db.Uuid
  pharmacyId  String   @map("pharmacy_id") @db.Uuid
  preferred   Boolean  @default(false)
  firstSeenAt DateTime @default(now()) @map("first_seen_at")

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  pharmacy Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@id([customerId, pharmacyId])
  @@index([pharmacyId])
  @@map("customer_pharmacies")
}

/// Per-pharmacy integration credentials & locale. Secrets are encrypted at rest.
model PharmacyIntegration {
  id                      String   @id @default(uuid()) @db.Uuid
  pharmacyId              String   @unique @map("pharmacy_id") @db.Uuid
  timezone                String   @default("Africa/Nairobi")
  locale                  String   @default("en-KE")
  currency                String   @default("KES")
  loyaltySpendMultiplier  Decimal  @default(0.01) @map("loyalty_spend_multiplier") @db.Decimal(10, 4)
  emailFromOverride       String?  @map("email_from_override")
  supportEmailOverride    String?  @map("support_email_override")
  supportPhoneOverride    String?  @map("support_phone_override")
  /// Daraja / M-Pesa
  darajaEnv               String?  @map("daraja_env")
  darajaShortcode         String?  @map("daraja_shortcode")
  darajaConsumerKeyEnc    String?  @map("daraja_consumer_key_enc")
  darajaConsumerSecretEnc String?  @map("daraja_consumer_secret_enc")
  darajaPasskeyEnc        String?  @map("daraja_passkey_enc")
  /// Twilio override (null = use platform env)
  twilioSmsFrom           String?  @map("twilio_sms_from")
  twilioAccountSidEnc     String?  @map("twilio_account_sid_enc")
  twilioAuthTokenEnc      String?  @map("twilio_auth_token_enc")
  /// WhatsApp Cloud override
  whatsappPhoneNumberId   String?  @map("whatsapp_phone_number_id")
  whatsappAccessTokenEnc  String?  @map("whatsapp_access_token_enc")
  /// POS integration
  posApiKeyHash           String?  @map("pos_api_key_hash")
  updatedAt               DateTime @updatedAt @map("updated_at")
  createdAt               DateTime @default(now()) @map("created_at")

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@map("pharmacy_integrations")
}

model PharmacyOnboardingEvent {
  id         String   @id @default(uuid()) @db.Uuid
  pharmacyId String   @map("pharmacy_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  type       String
  message    String
  meta       Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([pharmacyId, createdAt(sort: Desc)])
  @@map("pharmacy_onboarding_events")
}

/// Platform-level CMS / branding (super admin). Singleton row id="platform".
model PlatformSettings {
  id                 String   @id @default("platform")
  name               String   @default("Aether")
  tagline            String   @default("The pharmacy network for Kenya")
  description        String   @default("One account. Every neighbourhood pharmacy. Prescriptions, refills, and care — close to home.")
  supportEmail       String   @default("support@gtss.software") @map("support_email")
  supportPhone       String   @default("0790670542") @map("support_phone")
  marketplaceHero    String?  @map("marketplace_hero")
  aboutMarkdown      String?  @map("about_markdown")
  forPharmaciesMd    String?  @map("for_pharmacies_md")
  updatedAt          DateTime @updatedAt @map("updated_at")
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("platform_settings")
}

// ── Auth ──────────────────────────────────────────────────────

model User {
  id               String     @id @default(uuid()) @db.Uuid
  email            String     @unique
  /// Null for OAuth-only accounts (e.g. Google sign-in).
  passwordHash     String?    @map("password_hash")
  /// Google subject (`sub`) when the account is linked to Google.
  googleId         String?    @unique @map("google_id")
  role             UserRole   @default(customer)
  emailVerified    Boolean    @default(false) @map("email_verified")
  phoneVerified    Boolean    @default(false) @map("phone_verified")
  twoFactorEnabled Boolean    @default(false) @map("two_factor_enabled")
  twoFactorSecret  String?    @map("two_factor_secret")
  status           UserStatus @default(active)
  /// Platform super-admin (verifies pharmacies, manages the network). Independent of pharmacy membership.
  platformAdmin    Boolean    @default(false) @map("platform_admin")
  lastLoginAt      DateTime?  @map("last_login_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  sessions            Session[]
  passwordResets      PasswordReset[]
  emailVerifications  EmailVerification[]
  profile             CustomerProfile?
  caregiverLinks      Caregiver[]            @relation("CaregiverUser")
  assignedRefills     RefillRequest[]        @relation("RefillAssignee")
  timelineAsUser      TimelineEvent[]        @relation("TimelineUser")
  timelineCreated     TimelineEvent[]        @relation("TimelineCreator")
  assignedConversations Conversation[]       @relation("ConversationAssignee")
  messagesSent        Message[]
  templatesCreated    MessageTemplate[]     @relation("TemplateCreator")
  templatesUpdated    MessageTemplate[]     @relation("TemplateUpdater")
  notifications       Notification[]
  remindersCreated    Reminder[]
  campaignsCreated    Campaign[]
  loyaltyTxCreated    LoyaltyTransaction[]
  enquiriesAssigned   Enquiry[]              @relation("EnquiryAssignee")
  feedbackResponded   Feedback[]             @relation("FeedbackResponder")
  knowledgeCreated    KnowledgeArticle[]     @relation("KnowledgeCreator")
  knowledgeUpdated    KnowledgeArticle[]     @relation("KnowledgeUpdater")
  aiConversations     AiConversation[]
  auditLogs           AuditLog[]
  customerNotes       CustomerNote[]
  segmentsCreated     Segment[]
  pushDevices         PushDevice[]
  dispatchedPrescriptions Prescription[] @relation("PrescriptionDispatcher")
  orderDispenserNotes Order[]            @relation("OrderDispenser")
  symptomSessions     SymptomSession[]       @relation("SymptomSessionUser")
  symptomStaffReplies SymptomMessage[]       @relation("SymptomStaffSender")
  pharmacySettingsUpdated PharmacySettings[] @relation("PharmacySettingsUpdater")
  serviceBookingsRecorded ServiceBooking[]   @relation("ServiceBookingRecorder")
  // ── Commerce ledger relations (audit §41) ──
  prescriptionFillsDispensed PrescriptionFill[] @relation("PrescriptionFillDispenser")
  reservationCreator          InventoryReservation[] @relation("ReservationCreator")
  refundCreator               Refund[]               @relation("RefundCreator")
  refundApprover              Refund[]               @relation("RefundApprover")
  priceHistoryChanges         MedicationPriceHistory[] @relation("PriceHistoryChanger")
  cashierSessions             CashierSession[]      @relation("CashierSessionUser")
  prescriptionsReviewed       Prescription[]        @relation("PrescriptionReviewer")
  clarificationLogs           PrescriptionClarificationLog[] @relation("ClarificationStaff")
  adherenceFollowUpsRecorded  AdherenceFollowUp[]   @relation("FollowUpStaff")
  screeningsConducted         HealthScreeningRecord[] @relation("ScreeningConductedBy")
  referralsIssued             ClinicalReferral[]      @relation("ReferralPharmacist")
  immunizationPolicyUpdated   PharmacyImmunizationPolicy[] @relation("ImmunizationPolicyUpdater")
  immunizerCredentials        ImmunizerCredential[]        @relation("ImmunizerCredentials")
  immunizationAssigned        ImmunizationAppointment[]    @relation("ImmunizationAssignee")
  vaccinationScreenings       PreVaccinationScreening[]    @relation("VaccinationScreener")
  immunizationsAdministered   ImmunizationRecord[]         @relation("ImmunizationAdministeredBy")
  immunizationsSupervised     ImmunizationRecord[]         @relation("ImmunizationSupervisor")
  aefiReportsFiled            AdverseEventFollowingImmunization[] @relation("AefiReporter")
  counsellingSessionsGiven    PreventiveCounsellingSession[] @relation("PreventiveCounsellor")

  memberships           PharmacyMembership[]
  ownedPharmacies       Pharmacy[]              @relation("PharmacyOwner")
  verifiedPharmacies    Pharmacy[]              @relation("PharmacyVerifier")

  @@map("users")
}

/// Browser/device tokens used by firebase-admin to deliver FCM web push notifications.
/// One user can have multiple devices (desktop, phone, tablet) — we fan out to all of them.
model PushDevice {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// The FCM registration token returned by `getToken()` in the browser.
  token     String   @unique
  /// User-agent so the user can recognise "Chrome on Mac", "iPhone Safari", etc.
  label     String?
  /// Bumped on every /api/push/register call so we can prune stale devices.
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_devices")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

model EmailVerification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verifications")
}

// ── Customers ─────────────────────────────────────────────────

/// Onboarding stage — customer must complete profile before fully accessing the portal.
/// proxy.ts allows /portal/onboarding through; everything else under /portal redirects there
/// until `onboardingCompletedAt` is set.
model CustomerProfile {
  id                      String       @id @default(uuid()) @db.Uuid
  userId                  String       @unique @map("user_id") @db.Uuid
  fullName                String       @map("full_name")
  phone                   String?
  dateOfBirth             DateTime?    @map("date_of_birth") @db.Date
  gender                  Gender?
  addressLine1            String?      @map("address_line1")
  addressLine2            String?      @map("address_line2")
  city                    String?
  state                   String?
  zip                     String?
  preferredCommunication  CommChannel  @default(email) @map("preferred_communication")
  emergencyContactName    String?      @map("emergency_contact_name")
  emergencyContactPhone   String?      @map("emergency_contact_phone")
  preferredBranch         String?      @default("Main Branch") @map("preferred_branch")
  notes                   String?
  tags                    String[]     @default([])
  /// Auto-tagged age segment: infant | child | teen | young_adult | adult | senior
  ageSegment              String?      @map("age_segment")
  /// Marks the moment the customer finished the onboarding wizard. Null = still onboarding.
  onboardingCompletedAt   DateTime?    @map("onboarding_completed_at")
  createdAt               DateTime     @default(now()) @map("created_at")
  updatedAt               DateTime     @updatedAt @map("updated_at")

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferences     CustomerPreference?
  caregivers      Caregiver[]
  prescriptions   Prescription[]
  refillRequests  RefillRequest[]
  timelineEvents  TimelineEvent[]
  segments        CustomerSegment[]
  conversations   Conversation[]
  notifications   Notification[]
  reminders       Reminder[]
  loyaltyAccounts LoyaltyAccount[]
  referredLoyalty LoyaltyAccount[]     @relation("LoyaltyReferrer")
  enquiries       Enquiry[]
  feedback        Feedback[]
  aiConversations AiConversation[]
  staffNotes      CustomerNote[]
  adherenceLogs   PrescriptionAdherence[]
  medicationSchedules MedicationSchedule[]
  doseLogs        DoseLog[]
  adherenceEscalations AdherenceEscalation[]
  orders          Order[]
  payments        Payment[]
  symptomSessions SymptomSession[]
  serviceBookings ServiceBooking[]
  syncEnrollment  RefillSyncEnrollment?
  adherenceFollowUps AdherenceFollowUp[]
  screeningRecords HealthScreeningRecord[]
  clinicalReferrals ClinicalReferral[]
  immunizationAppointments ImmunizationAppointment[]
  preVaccinationScreenings PreVaccinationScreening[]
  vaccinationConsents      VaccinationConsent[]
  immunizationRecords      ImmunizationRecord[]
  counsellingSessions      PreventiveCounsellingSession[]

  pharmacies          CustomerPharmacy[]
  @@index([ageSegment])
  @@map("customer_profiles")
}

model Caregiver {
  id                            String          @id @default(uuid()) @db.Uuid
  customerId                    String          @map("customer_id") @db.Uuid
  caregiverUserId               String?         @map("caregiver_user_id") @db.Uuid
  caregiverName                 String          @map("caregiver_name")
  caregiverEmail                String?         @map("caregiver_email")
  caregiverPhone                String?         @map("caregiver_phone")
  relationship                  String?
  canRequestRefills             Boolean         @default(true) @map("can_request_refills")
  canReceivePickupNotifications Boolean         @default(true) @map("can_receive_pickup_notifications")
  /// Whether the caregiver can log medication adherence on the patient's behalf.
  /// Patients grant this when they want a family member to mark doses as taken/missed.
  canLogAdherence               Boolean         @default(true) @map("can_log_adherence")
  status                        CaregiverStatus @default(active)
  lastInviteSentAt              DateTime?       @map("last_invite_sent_at")
  inviteSendCount               Int             @default(0) @map("invite_send_count")
  createdAt                     DateTime        @default(now()) @map("created_at")

  customer      CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  caregiverUser User?           @relation("CaregiverUser", fields: [caregiverUserId], references: [id], onDelete: SetNull)
  invites       CaregiverInvite[]

  @@index([customerId])
  @@map("caregivers")
}

model CustomerPreference {
  id                String   @id @default(uuid()) @db.Uuid
  customerId        String   @unique @map("customer_id") @db.Uuid
  emailEnabled      Boolean  @default(true) @map("email_enabled")
  smsEnabled        Boolean  @default(true) @map("sms_enabled")
  whatsappEnabled   Boolean  @default(true) @map("whatsapp_enabled")
  marketingConsent  Boolean  @default(false) @map("marketing_consent")
  reminderConsent   Boolean  @default(true) @map("reminder_consent")
  birthdayMessages  Boolean  @default(true) @map("birthday_messages")
  updatedAt         DateTime @updatedAt @map("updated_at")

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_preferences")
}

// ── Prescriptions & Refills ───────────────────────────────────

model Prescription {
  id               String             @id @default(uuid()) @db.Uuid
  pharmacyId      String    @default("00000000-0000-4000-a000-000000000001") @map("pharmacy_id") @db.Uuid
  customerId       String             @map("customer_id") @db.Uuid
  medicineName     String             @map("medicine_name")
  rxReference      String?            @map("rx_reference")
  dosage           String?
  /// Free-text schedule like "1 tablet twice daily after meals". AI uses this to predict refill dates.
  schedule         String?
  quantity         Int?
  /// Billing unit for this prescription (tablet, bottle, pack, etc.) — audit §14.
  billingUnit      BillingUnit?       @default(UNIT) @map("billing_unit")
  /// Days of supply per fill (used to predict next refill date).
  daysSupply       Int?               @map("days_supply")
  refillsRemaining Int?               @default(0) @map("refills_remaining")
  lastFilledAt     DateTime?          @map("last_filled_at") @db.Date
  nextRefillDue    DateTime?          @map("next_refill_due") @db.Date
  /// Explicit course start date (admin-settable; falls back to createdAt when null).
  startDate        DateTime?          @map("start_date") @db.Date
  /// When the prescription should be terminated (e.g. 6-month course ended).
  endDate          DateTime?          @db.Date
  prescriber       String?
  /// Admin-set price the customer pays per refill (used by payment system).
  unitPrice        Decimal?           @db.Decimal(10, 2) @map("unit_price")
  status           PrescriptionStatus @default(active)
  /// Flag indicating if this is a chronic maintenance therapy.
  isChronic        Boolean            @default(false) @map("is_chronic")
  /// Chronic disease category (e.g. Hypertension, Diabetes, Asthma, Dyslipidemia, Thyroid, etc.).
  chronicCondition String?            @map("chronic_condition")
  /// Refill Synchronization (Med Sync) status.
  isSynced         Boolean            @default(false) @map("is_synced")
  /// Synchronized monthly anchor day (1-28).
  syncAnchorDay    Int?               @map("sync_anchor_day")
  /// Structured intake arrival channel (paper, whatsapp, email, patient upload, referral, hospital, e-rx, phone, in-person).
  intakeChannel    PrescriptionIntakeChannel? @default(in_person_consultation) @map("intake_channel")
  /// Granular prescription lifecycle progression.
  lifecycleStatus  PrescriptionLifecycleStatus? @default(received) @map("lifecycle_status")
  /// Patient verification details.
  patientVerified  Boolean            @default(false) @map("patient_verified")
  patientVerifiedAt DateTime?         @map("patient_verified_at")
  patientVerificationNotes String?    @map("patient_verification_notes")
  /// Prescriber verification details.
  prescriberLicense String?           @map("prescriber_license")
  prescriberPhone   String?           @map("prescriber_phone")
  prescriberEmail   String?           @map("prescriber_email")
  prescriberFacility String?          @map("prescriber_facility")
  prescriberVerified Boolean          @default(false) @map("prescriber_verified")
  prescriberVerifiedAt DateTime?      @map("prescriber_verified_at")
  /// Clinical clarity & Prescriber clarification tracking.
  isUnclear        Boolean            @default(false) @map("is_unclear")
  unclearReason    String?            @map("unclear_reason")
  clarificationStatus ClarificationStatus @default(none) @map("clarification_status")
  clarificationContactMethod String?  @map("clarification_contact_method")
  clarificationNotes String?          @map("clarification_notes")
  clarificationContactedAt DateTime?  @map("clarification_contacted_at")
  clarificationResolvedAt DateTime?   @map("clarification_resolved_at")
  /// Professional review & Pharmacist decision.
  reviewedById     String?            @map("reviewed_by_id") @db.Uuid
  reviewedAt       DateTime?          @map("reviewed_at")
  reviewDecision   String?            @map("review_decision")
  reviewNotes      String?            @map("review_notes")
  rejectionReason  String?            @map("rejection_reason")
  holdReason       String?            @map("hold_reason")
  /// Scanned script, photo, PDF, or referral document URLs.
  attachmentUrls   String[]           @default([]) @map("attachment_urls")
  /// Linked commercial dispensing order (when converted).
  dispensingOrderId String?           @map("dispensing_order_id") @db.Uuid
  notes            String?
  /// Optional link to a Medication catalogue row. When set, dispatching this
  /// prescription decrements the medication's stock by `quantity`.
  /// Nullable so legacy free-text prescriptions still work.
  medicationId     String?            @map("medication_id") @db.Uuid
  /// Set when an admin clicks "Dispatch" on the prescription. Null = pending.
  dispatchedAt     DateTime?          @map("dispatched_at")
  dispatchedById   String?            @map("dispatched_by_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  customer         CustomerProfile       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  refillRequests   RefillRequest[]
  adherence        PrescriptionAdherence[]
  medication       PharmacyInventory?    @relation(fields: [medicationId], references: [id], onDelete: SetNull)
  dispatchedBy     User?                 @relation("PrescriptionDispatcher", fields: [dispatchedById], references: [id], onDelete: SetNull)
  reviewedBy       User?                 @relation("PrescriptionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  dispensingOrder  Order?                @relation("PrescriptionDispensingOrder", fields: [dispensingOrderId], references: [id], onDelete: SetNull)
  doseSchedule     MedicationSchedule[]
  doseLogs         DoseLog[]
  escalations      AdherenceEscalation[]
  clarificationLogs PrescriptionClarificationLog[]
  adherenceFollowUps AdherenceFollowUp[]
  /// Commerce ledger: one row per fill (audit §4 / §41.A).
  fills            PrescriptionFill[]

  @@index([customerId])
  @@index([status])
  @@index([isChronic])
  @@index([lifecycleStatus])
  @@index([intakeChannel])
  @@index([medicationId])
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)

  @@index([pharmacyId])
  @@map("prescriptions")
}

model RefillRequest {
  id                String           @id @default(uuid()) @db.Uuid
  pharmacyId      String    @default("00000000-0000-4000-a000-000000000001") @map("pharmacy_id") @db.Uuid
