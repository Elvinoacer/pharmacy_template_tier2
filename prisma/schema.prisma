// ── Prescription adherence tracking ───────────────────────────
/// Daily log of whether a customer took their medication. Customers log this from the portal;
/// AI uses it to generate adherence insights and refill-date predictions.
model PrescriptionAdherence {
  id            String   @id @default(uuid()) @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  prescriptionId String  @map("prescription_id") @db.Uuid
  /// Local YYYY-MM-DD of the dose being recorded (no timezone surprises).
  takenOn       DateTime @map("taken_on") @db.Date
  status        String   @default("taken") // taken | missed | skipped | late
  notes         String?
  /// Who recorded this entry: "customer" (self) or "caregiver" (delegated).
  recordedBy    String   @default("customer") @map("recorded_by")
  /// When a caregiver logged the dose, this is the caregiver row's id.
  caregiverId   String?  @map("caregiver_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  customer    CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  prescription Prescription    @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@unique([prescriptionId, takenOn])
  @@index([customerId, takenOn])
  @@map("prescription_adherence")
}

model PrescriptionClarificationLog {
  id             String   @id @default(uuid()) @db.Uuid
  prescriptionId String   @map("prescription_id") @db.Uuid
  contactMethod  String   @map("contact_method") // phone | whatsapp | email | in_person | fax
  contactedTo    String   @map("contacted_to") // Prescriber name / phone / clinic
  inquiryDetails String   @map("inquiry_details") // Details of ambiguity / dosage / substitution
  doctorResponse String?  @map("doctor_response") // Prescriber resolution
  resolved       Boolean  @default(false)
  staffId        String?  @map("staff_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  staff        User?        @relation("ClarificationStaff", fields: [staffId], references: [id], onDelete: SetNull)

  @@index([prescriptionId])
  @@index([createdAt(sort: Desc)])
  @@map("prescription_clarification_logs")
}

// ── Per-dose medication schedule ──────────────────────────────
/// A scheduled dose slot for a prescription. Generated from the prescription's
/// dosage/frequency text (e.g. "1 tablet twice daily" → two slots: 08:00, 20:00).
/// One MedicationSchedule row per (prescription, time-of-day). Used by the
/// reminder cron to fire dose reminders and by the adherence escalation cron
/// to follow up on unconfirmed doses.
model MedicationSchedule {
  id             String   @id @default(uuid()) @db.Uuid
  pharmacyId      String    @default("00000000-0000-4000-a000-000000000001") @map("pharmacy_id") @db.Uuid
  prescriptionId String   @map("prescription_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  /// Time-of-day in HH:mm (24h, project timezone). E.g. "08:00", "20:00".
  timeOfDay      String   @map("time_of_day")
  /// How many doses per day this slot represents (used for daily-frequency meds).
  /// For a once-daily med there is one row with quantity 1; twice-daily two rows of 1, etc.
  doseQuantity   Decimal  @default(1) @map("dose_quantity") @db.Decimal(10, 2)
  /// Optional label like "Morning", "Evening", "With food".
  label          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  customer     CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  doseLogs     DoseLog[]

  @@unique([prescriptionId, timeOfDay])
  @@index([customerId])
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)

  @@index([pharmacyId])
  @@map("medication_schedules")
}

// ── Per-dose log (granular) ───────────────────────────────────
/// A single dose confirmation. Unlike PrescriptionAdherence (one record per day),
/// DoseLog records each individual scheduled dose with its actual time + responder.
/// When the patient/caregiver taps "I took it" from a reminder, a DoseLog is created.
model DoseLog {
  id             String   @id @default(uuid()) @db.Uuid
  prescriptionId String   @map("prescription_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  scheduleId     String?  @map("schedule_id") @db.Uuid
  /// The date the dose was scheduled for (local YYYY-MM-DD).
  scheduledDate  DateTime @map("scheduled_date") @db.Date
  /// Time-of-day the dose was scheduled for (HH:mm), or null for ad-hoc.
  scheduledTime  String?  @map("scheduled_time")
  /// When the dose was actually confirmed. Null = pending.
  confirmedAt    DateTime? @map("confirmed_at")
  /// taken | missed | skipped | late | unknown
  status         String   @default("taken")
  /// customer | caregiver | system (system = auto-marked unknown after escalation)
  recordedBy     String   @default("customer") @map("recorded_by")
  caregiverId    String?  @map("caregiver_id") @db.Uuid
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  customer     CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  schedule     MedicationSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@unique([prescriptionId, scheduledDate, scheduledTime])
  @@index([customerId, scheduledDate])
  @@index([status])
  @@map("dose_logs")
}

// ── Adherence escalation chain ────────────────────────────────
/// Records each escalation step when a dose reminder goes unconfirmed.
/// Step 1 = first reminder sent; Step 2 = follow-up after 15 min; Step 3 = mark unknown + alert caregiver.
model AdherenceEscalation {
  id             String   @id @default(uuid()) @db.Uuid
  prescriptionId String   @map("prescription_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  reminderId     String?  @map("reminder_id") @db.Uuid
  doseLogId      String?  @map("dose_log_id") @db.Uuid
  scheduledDate  DateTime @map("scheduled_date") @db.Date
  scheduledTime  String?  @map("scheduled_time")
  step           Int      @default(1)
  /// What this escalation did: reminder_sent | follow_up_sent | marked_unknown | caregiver_notified
  action         String
  createdAt      DateTime @default(now()) @map("created_at")

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  customer     CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([prescriptionId, scheduledDate])
  @@map("adherence_escalations")
}

// ── Medication synchronization (Med Sync) ─────────────────────
/// Patient enrollment in the recurring refill synchronization program.
/// Aligns multiple chronic maintenance prescriptions to a unified monthly anchor day.
model RefillSyncEnrollment {
  id                    String           @id @default(uuid()) @db.Uuid
  customerId            String           @unique @map("customer_id") @db.Uuid
  /// Day of the month (1-28) when all synced medications are renewed/dispensed together.
  anchorDay             Int              @default(1) @map("anchor_day")
  /// active | pending_review | paused | cancelled
  status                String           @default("active")
  preferredPickup       PickupPreference @default(pickup) @map("preferred_pickup")
  notes                 String?
  enrolledAt            DateTime         @default(now()) @map("enrolled_at")
  nextSyncDate          DateTime?        @map("next_sync_date") @db.Date
  lastSyncDate          DateTime?        @map("last_sync_date") @db.Date
  syncedPrescriptionIds String[]         @default([]) @map("synced_prescription_ids")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("refill_sync_enrollments")
}

// ── Pharmacist Clinical Follow-up Calls & Adherence Outreach ───
/// Records structured clinical follow-up calls and interventions conducted by pharmacy staff.
/// Covers low adherence, missed refills, missed doses, side effects, and sync consultations.
model AdherenceFollowUp {
  id                 String           @id @default(uuid()) @db.Uuid
  customerId         String           @map("customer_id") @db.Uuid
  prescriptionId     String?          @map("prescription_id") @db.Uuid
  /// missed_dose | refill_lapse | low_adherence | med_sync | side_effects | routine_checkin
  reason             String
  /// reached_patient | reached_caregiver | voicemail | busy_no_answer | wrong_number | refused
  callOutcome        String           @map("call_outcome")
  /// side_effects | cost | regimen_complexity | forgetfulness | feeling_better | transport | none | other
  barrierIdentified  String?          @map("barrier_identified")
  /// education | adjusted_schedule | enrolled_sync | prescriber_consult | generic_substitution | scheduled_followup | none
  clinicalAction     String           @map("clinical_action")
  notes              String?
  nextFollowUpDate   DateTime?        @map("next_follow_up_date") @db.Date
  staffId            String?          @map("staff_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at")

  customer     CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  prescription Prescription?    @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  staff        User?            @relation("FollowUpStaff", fields: [staffId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([prescriptionId])
  @@index([createdAt(sort: Desc)])
  @@map("adherence_follow_ups")
}

// ── Medication categories (taxonomy registry) ─────────────────
/// Canonical list of catalogue categories. Medication.category stores the slug
/// as free-text for POS/import flexibility; this table powers admin CRUD,
/// empty categories (0 meds), descriptions, and form dropdowns.
/// Public medicines browse uses the same rows (image, brands, tips, publicVisible).
model MedicationCategory {
  id          String   @id @default(uuid()) @db.Uuid
  pharmacyId      String    @default("00000000-0000-4000-a000-000000000001") @map("pharmacy_id") @db.Uuid
  /// Human label shown in UI, e.g. "Pain Relief".
  name        String
  /// Stable key stored on Medication.category, e.g. "pain-relief".
  slug        String
  description String?
  /// Public card / detail hero image (relative path or R2 URL).
  imageUrl    String?  @map("image_url")
  /// Featured brands shown on the public category page.
  brands      String[] @default([])
  /// Pharmacist tips shown on the public category page.
  tips        String[] @default([])
  /// When false, category stays in admin/forms but is hidden from public browse.
  publicVisible Boolean @default(true) @map("public_visible")
  sortOrder   Int      @default(0) @map("sort_order")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([active])
  @@index([publicVisible])
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)

  @@index([pharmacyId])
  @@unique([pharmacyId, slug])
  @@map("medication_categories")
}

// ── Medication master (shared clinical registry) ──────────────
/// Universal clinical drug data — shared across all pharmacies (the "shared library").
/// Per Phase 0 of MEDICATION_MODULE_IMPLEMENTATION.md + DECISIONS.md D1-D4:
/// clinical/universal fields live here; commercial/inventory fields live on PharmacyInventory.
/// OTC/Prescription flags are on PharmacyInventory (can vary by pharmacy jurisdiction).
model MedicationMaster {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  /// Display slug. NOT unique on the master (master is shared; unique slugs are per-pharmacy on PharmacyInventory).
  slug            String
  /// INN / generic name, e.g. "Paracetamol". Required (Phase 4 validation).
  genericName     String   @map("generic_name")
  /// Comma-separated brand equivalents, e.g. "Panadol, Calpol, Tylenol". V1 text (Decision D5).
  brandName       String?  @map("brand_name")
  /// Structured strength value for sorting/filtering (nullable for combination drugs).
  strengthValue   Decimal? @db.Decimal(10, 4) @map("strength_value")
  strengthUnit    String?  @map("strength_unit")
  /// Human-readable strength; supports combos like "500 mg + 65 mg".
  strengthDisplay String?  @map("strength_display")
  /// Pack size free text, e.g. "10 tablets", "100ml bottle", "5 ampoules".
  packSize        String?  @map("pack_size")
  /// FK to MedicationLookup where kind=dosage_form. Required (Phase 4 validation).
  dosageFormId    String?  @map("dosage_form_id") @db.Uuid
  /// FK to MedicationLookup where kind=route.
  routeId         String?  @map("route_id") @db.Uuid
  /// FK to MedicationLookup where kind=pregnancy_category.
  pregnancyCategoryId String? @map("pregnancy_category_id") @db.Uuid
  /// FK to Manufacturer.
  manufacturerId  String?  @map("manufacturer_id") @db.Uuid
  countryOfOrigin String?  @map("country_of_origin")
  /// Unique product barcode (EAN/GTIN). Unique-indexed for Phase 3.2 lookup + Phase 4 validation.
  barcode         String?  @unique
  /// Matches MedicationCategory.slug when managed via admin categories.
  category        String   @default("general")
  description     String?
  /// Markdown-rendered on the public detail page.
  indications     String?
  dosage          String?
  sideEffects     String?  @map("side_effects")
  contraindications String?
  storage         String?
  /// Extra clinical notes / pharmacology details.
  clinicalNotes   String?  @map("clinical_notes")
  imageUrl        String?  @map("image_url")
  /// Extra gallery image URLs (comma-separated).
  imageUrls       String?  @map("image_urls")
  /// Optional list of equivalent MedicationMaster IDs (comma-separated UUIDs).
  alternativeIds  String?  @map("alternative_ids")
  controlledDrug  Boolean  @default(false) @map("controlled_drug")
  /// Required when controlledDrug=true (Phase 4 validation). Kenya PPB schedules 1-5.
  controlledDrugSchedule String? @map("controlled_drug_schedule")
  pediatricUse    Boolean  @default(false) @map("pediatric_use")
  requiresRefrigeration Boolean @default(false) @map("requires_refrigeration")
  /// Phase 5 enrichment tracking (Decision D14).
  enrichmentStatus String  @default("minimal") @map("enrichment_status")
  enrichmentScore Int      @default(0) @map("enrichment_score")
  enrichedAt      DateTime? @map("enriched_at")
  /// Phase 6 acquisition tracking (Decision D15).
  acquisitionMethod String @default("unknown") @map("acquisition_method")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  dosageForm      MedicationLookup? @relation("MedicationDosageForm", fields: [dosageFormId], references: [id], onDelete: SetNull)
  route           MedicationLookup? @relation("MedicationRoute", fields: [routeId], references: [id], onDelete: SetNull)
  pregnancyCategory MedicationLookup? @relation("MedicationPregnancyCategory", fields: [pregnancyCategoryId], references: [id], onDelete: SetNull)
  manufacturer    Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  activeIngredients MedicationActiveIngredient[]
  clinicalTags    MedicationClinicalTag[]
  interactionsA   MedicationInteraction[] @relation("InteractionA")
  interactionsB   MedicationInteraction[] @relation("InteractionB")
  pharmacyInventory PharmacyInventory[]

  @@index([genericName])
  @@index([category])
  @@index([controlledDrug])
  @@index([enrichmentStatus])
  @@index([acquisitionMethod])
  @@map("medication_masters")
}

// ── Per-pharmacy commercial inventory ───────────────────────────
/// Per-pharmacy stock record referencing a MedicationMaster (Phase 0.1B + Decisions D1, D2, D3).
/// Single-tenant (no pharmacyId — see D2). The id REUSES the old Medication.id (D3) so existing
/// OrderItem/Prescription FKs continue to resolve after the migration.
model PharmacyInventory {
  id              String   @id @default(uuid()) @db.Uuid
  pharmacyId      String    @default("00000000-0000-4000-a000-000000000001") @map("pharmacy_id") @db.Uuid
  medicationMasterId String @map("medication_master_id") @db.Uuid
  /// Pharmacy-specific slug. Unique per pharmacy (single-tenant → @unique).
  slug            String
  /// Pharmacy-specific SKU. Unique (single-tenant).
  sku             String?
  price           Decimal  @default(0) @db.Decimal(10, 2)
  purchasePrice   Decimal? @db.Decimal(10, 2) @map("purchase_price")
  currentStock    Int      @default(0) @map("current_stock")
  lowStockThreshold Int    @default(10) @map("low_stock_threshold")
  supplier        String?
  shelfLocation   String?  @map("shelf_location")
  promotions      String?
  /// OTC / Rx flags live here per Decision D1 (can vary by pharmacy jurisdiction).
  overTheCounter  Boolean  @default(false) @map("over_the_counter")
  prescriptionRequired Boolean @default(true) @map("prescription_required")
  publicListing   Boolean  @default(false) @map("public_listing")
  active          Boolean  @default(true)
  /// Last time the POS sync touched this row.
  syncedAt       DateTime? @map("synced_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  medicationMaster MedicationMaster @relation(fields: [medicationMasterId], references: [id], onDelete: Cascade)
  lots            InventoryLot[]
  movements       StockMovement[]
  orderItems      OrderItem[]
  prescriptions   Prescription[]
  /// Active reservations against this inventory row (audit §9).
  reservations    InventoryReservation[]
  /// Prescription fills linked to this inventory (audit §41.A).
  prescriptionFills PrescriptionFill[]
  /// Historical price points (audit §46).
  priceHistory    MedicationPriceHistory[]

  @@index([medicationMasterId])
  @@index([overTheCounter])
  @@index([publicListing])
  @@index([active])
  @@index([currentStock])
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)

  @@index([pharmacyId])
  @@unique([pharmacyId, slug])
  @@unique([pharmacyId, sku])
  @@map("pharmacy_inventory")
}

// ── Inventory lots (batch + expiry tracking, Phase 1.5) ─────────
/// One-to-many from PharmacyInventory. Supports multiple batches per medication per pharmacy
/// with separate expiry dates — needed for recall handling and expiry-based alerts.
model InventoryLot {
  id              String   @id @default(uuid()) @db.Uuid
  pharmacyInventoryId String @map("pharmacy_inventory_id") @db.Uuid
  batchNumber     String   @map("batch_number")
  expiryDate      DateTime @db.Date @map("expiry_date")
  quantity        Int      @default(0)
  receivedAt      DateTime @default(now()) @map("received_at")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  pharmacyInventory PharmacyInventory @relation(fields: [pharmacyInventoryId], references: [id], onDelete: Cascade)
  movements       StockMovement[]
  /// Lot-level stock reservations (audit §9).
  reservations    InventoryReservation[]
  /// Lot-level cost allocations against sold order items (audit §18).
  allocations     InventoryAllocation[]

  @@index([pharmacyInventoryId])
  @@index([expiryDate])
  @@index([active])
  @@map("inventory_lots")
}

// ── Stock movement ledger (audit trail for every stock change) ──
/// Every sale, receive, adjust, dispatch, refill, and POS sync writes a row here.
/// quantityDelta is signed: positive = stock in, negative = stock out.
model StockMovement {
  id                    String   @id @default(uuid()) @db.Uuid
  pharmacyId      String    @default("00000000-0000-4000-a000-000000000001") @map("pharmacy_id") @db.Uuid
  pharmacyInventoryId   String   @map("pharmacy_inventory_id") @db.Uuid
  inventoryLotId        String?  @map("inventory_lot_id") @db.Uuid
  /// sale | receive | adjust | dispatch | refill | pos_sync | return | write_off
  reason                String
  /// Signed delta applied to currentStock (e.g. -3 for a sale of 3).
  quantityDelta         Int      @map("quantity_delta")
  /// Stock level after this movement.
  balanceAfter          Int      @map("balance_after")
  /// Optional human note (adjustment reason, supplier invoice, etc.).
  notes                 String?
  /// Polymorphic link: order | prescription | refill_request | pos_sync | manual
  relatedType           String?  @map("related_type")
  relatedId             String?  @map("related_id") @db.Uuid
  actorId               String?  @map("actor_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")

  pharmacyInventory PharmacyInventory @relation(fields: [pharmacyInventoryId], references: [id], onDelete: Cascade)
  inventoryLot      InventoryLot?     @relation(fields: [inventoryLotId], references: [id], onDelete: SetNull)

  @@index([pharmacyInventoryId, createdAt(sort: Desc)])
  @@index([reason])
  @@index([relatedType, relatedId])
  @@index([createdAt(sort: Desc)])
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)

  @@index([pharmacyId])
  @@map("stock_movements")
}

// ── Active ingredients (relational, many-to-many, Phase 1.2) ────
model ActiveIngredient {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  medications MedicationActiveIngredient[]

  @@index([active])
  @@map("active_ingredients")
}

model MedicationActiveIngredient {
  id                  String   @id @default(uuid()) @db.Uuid
  medicationMasterId  String   @map("medication_master_id") @db.Uuid
  activeIngredientId  String   @map("active_ingredient_id") @db.Uuid
  /// Per-medication amount, e.g. "500" with unit "mg".
  amount              String?
  unit                String?
  createdAt           DateTime @default(now()) @map("created_at")

  medicationMaster    MedicationMaster @relation(fields: [medicationMasterId], references: [id], onDelete: Cascade)
  activeIngredient    ActiveIngredient @relation(fields: [activeIngredientId], references: [id], onDelete: Cascade)

  @@index([medicationMasterId])
  @@index([activeIngredientId])
  @@map("medication_active_ingredients")
}

// ── Manufacturer lookup (Phase 1.2) ────────────────────────────
model Manufacturer {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  country     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  medications MedicationMaster[]

  @@index([active])
  @@map("manufacturers")
}

// ── Drug interactions (self-referencing on MedicationMaster, Phase 1.2) ──
model MedicationInteraction {
  id                  String   @id @default(uuid()) @db.Uuid
  medicationMasterId  String   @map("medication_master_id") @db.Uuid
  interactsWithId    String   @map("interacts_with_id") @db.Uuid
  /// "minor" | "moderate" | "severe" | "contraindicated"
  severity            String   @default("moderate")
  description         String?
  createdAt           DateTime @default(now()) @map("created_at")

  medicationMaster    MedicationMaster @relation("InteractionA", fields: [medicationMasterId], references: [id], onDelete: Cascade)
  interactsWith       MedicationMaster @relation("InteractionB", fields: [interactsWithId], references: [id], onDelete: Cascade)

  @@unique([medicationMasterId, interactsWithId])
  @@index([medicationMasterId])
  @@index([interactsWithId])
  @@map("medication_interactions")
}

// ── Clinical tags (multi-select, editable, Phase 1.2) ──────────
model ClinicalTag {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  medications MedicationClinicalTag[]

  @@index([active])
  @@map("clinical_tags")
}

model MedicationClinicalTag {
  id                  String   @id @default(uuid()) @db.Uuid
  medicationMasterId  String   @map("medication_master_id") @db.Uuid
  clinicalTagId       String   @map("clinical_tag_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")

  medicationMaster    MedicationMaster @relation(fields: [medicationMasterId], references: [id], onDelete: Cascade)
  clinicalTag         ClinicalTag @relation(fields: [clinicalTagId], references: [id], onDelete: Cascade)

  @@unique([medicationMasterId, clinicalTagId])
  @@index([medicationMasterId])
  @@index([clinicalTagId])
  @@map("medication_clinical_tags")
}

// ── Editable lookup table (dosage forms, routes, pregnancy categories, Phase 1.3) ──
/// Single table with `kind` discriminator to avoid table proliferation (Decision D10).
/// kind values: "dosage_form" | "route" | "pregnancy_category".
/// Editable by admins so new values can be added without a schema/code change.
model MedicationLookup {
  id          String   @id @default(uuid()) @db.Uuid
  kind        String
  value       String
  slug        String
  sortOrder   Int      @default(0) @map("sort_order")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  dosageFormMeds      MedicationMaster[] @relation("MedicationDosageForm")
  routeMeds           MedicationMaster[] @relation("MedicationRoute")
  pregnancyCategoryMeds MedicationMaster[] @relation("MedicationPregnancyCategory")

  @@unique([kind, slug])
  @@index([kind, active])
  @@map("medication_lookups")
}

// ── Orders & Payments (POS / OTC / Refills) ──────────────────
/// An order ties together a customer, line items, and a payment. Used for OTC counter sales,
/// refill payments, and the portal shop. Created by staff at the counter, or by customers from the portal.
model Order {
  id           String   @id @default(uuid()) @db.Uuid
  pharmacyId      String    @default("00000000-0000-4000-a000-000000000001") @map("pharmacy_id") @db.Uuid
  customerId   String?  @map("customer_id") @db.Uuid
  /// Where the order originated: counter (staff at POS), portal (customer online), refill (linked to a RefillRequest), website (guest).
  source       String   @default("counter")
  refillId     String?  @map("refill_id") @db.Uuid
  /// pending | paid | fulfilled | cancelled | waived
  /// paid = money received, stock reserved; fulfilled = handed to customer (dispatched).
  status       String   @default("pending")
  total        Decimal  @default(0) @db.Decimal(10, 2)
  /// Admin can waive the payment — captured here so revenue reports stay accurate.
  waived       Boolean  @default(false)
  waivedReason String?  @map("waived_reason")
  /// If waived = one_time, the customer still pays on subsequent refills. If recurring_until, waived until `waivedUntil`.
  waivedScope  String?  @map("waived_scope") // one_time | recurring_until | recurring_permanent
  waivedUntil  DateTime? @map("waived_until")
  /// Free-text staff notes about this order (logistics / internal).
  notes        String?
  /// Customer-provided clinical reason for the medication (reservation / OTC).
  /// Kept separate from `notes` so M-Pesa phone and logistics text don't overwrite it.
  reason       String?
  /// Pharmacist/dispenser clinical note at handoff (condition observed, validity, counselling).
  dispenserNote   String?  @map("dispenser_note")
  dispenserNoteAt DateTime? @map("dispenser_note_at")
  dispenserNoteById String? @map("dispenser_note_by") @db.Uuid
  /// Guest / walk-in contact when no customer profile is linked.
  guestName    String?  @map("guest_name")
  guestPhone   String?  @map("guest_phone")
  guestEmail   String?  @map("guest_email")
  /// immediate = counter handoff (auto-dispatch eligible); reserve = remote hold until collection; delivery = rider.
  fulfillment  String   @default("reserve") // immediate | reserve | delivery
  /// When stock was physically handed over / rider left. Null = still reserved.
  dispatchedAt DateTime? @map("dispatched_at")
  dispatchedById String? @map("dispatched_by") @db.Uuid
  servedById   String?  @map("served_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // ── Commerce ledger extension (audit §16, §42, §63) ──────────
  /// Strongly-typed commercial category. Stays null on legacy rows; new writes always set it.
  type             OrderType?
  /// Stronger lifecycle state (separate from payment + fulfillment). Null = derive from `status`.
  lifecycleStatus  OrderLifecycleStatus? @map("lifecycle_status")
  /// Payment stage (separate from fulfillment). Null = derive from `status` for back-compat.
  paymentStage     PaymentStage?        @map("payment_stage")
  /// Fulfillment stage (separate from payment). Null = derive from `status`/`fulfillment`.
  fulfillmentStage FulfillmentStage?   @map("fulfillment_stage")
  currency         String               @default("KES")
  /// Subtotal before discount: sum(unitPrice × quantity) across items.
  subtotal         Decimal              @default(0) @db.Decimal(10, 2)
  /// Sum of all discountApplied across items.
  discountTotal    Decimal              @default(0) @map("discount_total") @db.Decimal(10, 2)
  /// Reserved for future VAT/tax; today most OTC sales are tax-inclusive.
  taxTotal         Decimal              @default(0) @map("tax_total") @db.Decimal(10, 2)
  /// Net amount the customer owes (subtotal - discount + tax).
  netTotal         Decimal              @default(0) @map("net_total") @db.Decimal(10, 2)
  /// Total amount actually collected (sum of completed payments - refunds).
  amountPaid       Decimal              @default(0) @map("amount_paid") @db.Decimal(10, 2)
  /// Total refunded against this order.
  amountRefunded   Decimal              @default(0) @map("amount_refunded") @db.Decimal(10, 2)
  /// Outstanding balance = netTotal - amountPaid + amountRefunded.
  amountDue        Decimal              @default(0) @map("amount_due") @db.Decimal(10, 2)
  /// Explicit lifecycle timestamps (audit §63) — never rely on `updatedAt` for finance.
  reservedAt         DateTime? @map("reserved_at")
  paymentInitiatedAt DateTime? @map("payment_initiated_at")
  paidAt             DateTime? @map("paid_at")
  preparingAt        DateTime? @map("preparing_at")
  readyAt            DateTime? @map("ready_at")
  outForDeliveryAt   DateTime? @map("out_for_delivery_at")
  fulfilledAt        DateTime? @map("fulfilled_at")
  cancelledAt        DateTime? @map("cancelled_at")
  expiredAt          DateTime? @map("expired_at")
  /// Default reservation TTL for remote/website orders (audit §10).
  expiresAt          DateTime? @map("expires_at")
  /// Structured reason enum for cancellations (audit §57).
  cancellationReason String?  @map("cancellation_reason")

  customer  CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  dispenserNoteBy User? @relation("OrderDispenser", fields: [dispenserNoteById], references: [id], onDelete: SetNull)
  items     OrderItem[]
  payments  Payment[]
  /// Optional 1:1 link when this order settles a priced pharmacy service booking.
  serviceBooking ServiceBooking?
  /// Commerce event ledger entries for this order.
  commerceEvents  CommerceEvent[]
  /// Refunds issued against any payment on this order.
  refunds         Refund[]
  /// Inventory reservations (stock held pending payment/collection).
  inventoryReservations InventoryReservation[]
  /// 1:0..1 fill row when this order paid for a prescription fill.
  prescriptionFill PrescriptionFill?
  /// Prescriptions converted into this dispensing order.
  dispensedPrescriptions Prescription[] @relation("PrescriptionDispensingOrder")

  @@index([customerId])
  @@index([status])
  @@index([guestPhone])
  @@index([dispatchedAt])
  @@index([createdAt(sort: Desc)])
  @@index([type])
  @@index([paymentStage])
  @@index([fulfillmentStage])
  @@index([lifecycleStatus])
  @@index([paidAt])
  @@index([fulfilledAt])
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)

  @@index([pharmacyId])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  medicationId String? @map("medication_id") @db.Uuid
  /// Snapshot of the medicine name (so historical orders don't break if the medication is renamed).
  name        String
  quantity    Int      @default(1)
  /// Billing unit for this line item (tablet, bottle, pack, etc.) — audit §14.
  billingUnit BillingUnit? @default(UNIT) @map("billing_unit")
  unitPrice   Decimal  @default(0) @db.Decimal(10, 2)
  /// If the customer used a coupon on this line, the discount applied.
  discountApplied Decimal @default(0) @map("discount_applied") @db.Decimal(10, 2)
  couponId    String?  @map("coupon_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  // ── Commerce ledger extension (audit §17, §41.D) ─────────────
  /// Snapshot of acquisition cost at sale time — preserves historical margin accuracy.
  unitCostSnapshot Decimal @default(0) @map("unit_cost_snapshot") @db.Decimal(10, 2)
  /// Gross amount = unitPrice × quantity (before discount).
  grossAmount      Decimal @default(0) @map("gross_amount") @db.Decimal(10, 2)
  /// Net amount = grossAmount - discountApplied.
  netAmount        Decimal @default(0) @map("net_amount") @db.Decimal(10, 2)
  /// Gross profit = netAmount - (unitCostSnapshot × quantity).
  grossProfit      Decimal @default(0) @map("gross_profit") @db.Decimal(10, 2)
  /// Tax/VAT allocated to this line.
  taxAmount        Decimal @default(0) @map("tax_amount") @db.Decimal(10, 2)
  /// Currency code snapshot (audit §17) — defaults to "KES".
  currency         String  @default("KES")
  /// Pricing rule that produced unitPrice (catalogue | promotion | manual_override).
  pricingRule      String? @map("pricing_rule")
  /// Linked prescription fill (audit §41.D).
  prescriptionFillId String? @map("prescription_fill_id") @db.Uuid
  /// Linked refill request (audit §17).
  refillRequestId   String? @map("refill_request_id") @db.Uuid

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medication PharmacyInventory? @relation(fields: [medicationId], references: [id], onDelete: SetNull)
  coupon     Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  /// Lot-level allocations (one item can consume multiple lots, audit §18).
  allocations    InventoryAllocation[]
  reservations   InventoryReservation[]

  @@index([orderId])
  @@index([prescriptionFillId])
  @@index([refillRequestId])
  @@index([medicationId])
  @@map("order_items")
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
  waived
}

enum PaymentProvider {
  daraja
  cash
  card
  other
}

model Payment {
  id           String         @id @default(uuid()) @db.Uuid
  pharmacyId      String    @default("00000000-0000-4000-a000-000000000001") @map("pharmacy_id") @db.Uuid
  orderId      String         @map("order_id") @db.Uuid
  customerId   String?        @map("customer_id") @db.Uuid
  amount       Decimal        @db.Decimal(10, 2)
  provider     PaymentProvider @default(daraja)
  status       PaymentStatus  @default(pending)
  /// M-Pesa receipt number (or CASH-… / WAIVE-… refs for non-Daraja).
  providerRef  String?        @map("provider_ref")
  /// Daraja STK CheckoutRequestID — stable key for callbacks + status polling.
  checkoutRequestId String?   @map("checkout_request_id")
  /// Daraja MerchantRequestID (audit).
  merchantRequestId String?   @map("merchant_request_id")
  /// Phone number used for M-Pesa STK push (2547…).
  phone        String?
  failureReason String?       @map("failure_reason")
  /// How many STK push attempts for this payment row (retries share the same logical payment intent per order).
  attemptCount Int            @default(1) @map("attempt_count")
  lastAttemptAt DateTime?     @map("last_attempt_at")
  /// Who initiated the STK (staff counter sale vs customer self-serve).
  initiatedById String?       @map("initiated_by") @db.Uuid
  /// Explicit timestamp for when the payment actually settled (audit §62).
  paidAt       DateTime?      @map("paid_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// First-class refunds issued against this payment (audit §14).
  refunds Refund[]

  @@index([orderId])
  @@index([status])
  @@index([checkoutRequestId])
  @@index([phone])
  @@index([paidAt])
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)

  @@index([pharmacyId])
  @@map("payments")
}

// ── Loyalty automation rules ─────────────────────────────────
/// Configurable rules so loyalty points are earned automatically without manual taps.
/// e.g. "Earn 10 points for every completed refill", "Earn 1 point per KES 100 spent".
/// A cron job (or event hook) reads these and credits points accordingly.
model LoyaltyRule {
  id          String   @id @default(uuid()) @db.Uuid
  pharmacyId      String    @default("00000000-0000-4000-a000-000000000001") @map("pharmacy_id") @db.Uuid
  name        String
  trigger     String   // refill_completed | order_paid | first_order | birthday | referral_completed
  points      Int      @default(0)
  /// Optional multiplier: for order_paid, points = floor(amount * multiplier / 100).
  multiplier  Decimal? @db.Decimal(10, 4)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)

  @@index([pharmacyId])
  @@unique([pharmacyId, name])
  @@map("loyalty_rules")
}

// ── Caregiver invitations ────────────────────────────────────
/// Token-based invite links emailed to a caregiver so they can finish setting up their own account
/// and link back to the patient. One token per invite, single-use, expires in 7 days.
model CaregiverInvite {
  id          String   @id @default(uuid()) @db.Uuid
  caregiverId String   @map("caregiver_id") @db.Uuid
  email       String
  tokenHash   String   @unique @map("token_hash")
  expiresAt   DateTime @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime @default(now()) @map("created_at")

  caregiver Caregiver @relation(fields: [caregiverId], references: [id], onDelete: Cascade)

  @@map("caregiver_invites")
}

// ── Pharmacy services (public catalogue + bookings) ───────────
/// Dynamic pharmacy care services shown on /services. Seeded from the former static
/// catalogue; admin can CRUD freely. Optional price: when set, online bookings must
/// be paid (M-Pesa or counter) before status becomes confirmed.
model PharmacyService {
  id          String   @id @default(uuid()) @db.Uuid
  pharmacyId      String    @default("00000000-0000-4000-a000-000000000001") @map("pharmacy_id") @db.Uuid
  slug        String
  title       String
  /// One-line card blurb.
  short       String
  description String
  benefits    String[] @default([])
  eligibility String?
  duration    String?
  imageUrl    String?  @map("image_url")
  icon        String?
  /// Optional fixed price in KES. Null = no online payment required to confirm.
  price       Decimal? @db.Decimal(10, 2)
  /// Accept online booking forms.
  bookable    Boolean  @default(true)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  bookings ServiceBooking[]

  @@index([active, sortOrder])
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)

  @@index([pharmacyId])
  @@unique([pharmacyId, slug])
  @@map("pharmacy_services")
}

/// Customer request for a PharmacyService.
/// Status flow:
///   awaiting_payment — priced service, not yet paid (not confirmed)
///   confirmed        — free service accepted, or priced service paid
///   completed        — staff marked the visit/service done
///   cancelled        — cancelled by staff or customer
/// Payment status:
///   none | unpaid | pending | paid | waived | cash
model ServiceBooking {
  id              String   @id @default(uuid()) @db.Uuid
  pharmacyId      String    @default("00000000-0000-4000-a000-000000000001") @map("pharmacy_id") @db.Uuid
  serviceId       String   @map("service_id") @db.Uuid
  customerId      String?  @map("customer_id") @db.Uuid
  fullName        String   @map("full_name")
  /// Required contact for all bookings (M-Pesa + follow-up).
  phone           String
  email           String?
  notes           String?
  preferredDate   String?  @map("preferred_date")
  preferredTime   String?  @map("preferred_time")
  /// awaiting_payment | confirmed | completed | cancelled
  status          String   @default("confirmed")
  /// none | unpaid | pending | paid | waived | cash
  paymentStatus   String   @default("none") @map("payment_status")
  /// Snapshot of service.price at booking time (null when free / unpriced).
  amount          Decimal? @db.Decimal(10, 2)
  /// Linked Order used for M-Pesa STK / cash recording when amount > 0.
  orderId         String?  @unique @map("order_id") @db.Uuid
  paidAt          DateTime? @map("paid_at")
  /// daraja | cash | card | other | waive
  paidVia         String?  @map("paid_via")
  paymentRef      String?  @map("payment_ref")
  recordedById    String?  @map("recorded_by") @db.Uuid
  staffNotes      String?  @map("staff_notes")
  /// One-shot FCM token from the booking browser (guest push without account).
  pushToken       String?  @map("push_token")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  service    PharmacyService  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customer   CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order      Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  recordedBy User?            @relation("ServiceBookingRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  immunizationAppointment ImmunizationAppointment?

  @@index([serviceId])
  @@index([status])
  @@index([paymentStatus])
  @@index([phone])
  @@index([createdAt(sort: Desc)])
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)

  @@index([pharmacyId])
  @@map("service_bookings")
}

// ── Inbound admin notifications ───────────────────────────────
/// A separate model from Notification (which is outbound to customers). AdminNotification is
/// for inbound events the staff team needs to see: new refill, new enquiry, low feedback, etc.
/// Has its own read/unread state, severity, and a `retry` action when applicable.
model AdminNotification {
  id         String   @id @default(uuid()) @db.Uuid
  pharmacyId      String    @default("00000000-0000-4000-a000-000000000001") @map("pharmacy_id") @db.Uuid
  /// Type of event: refill_new | enquiry_new | feedback_low | ai_escalation | stock_low | payment_failed | campaign_failed | reminder_failed | symptom_escalation | symptom_checkin
  type       String
  title      String
  body       String
  severity   String   @default("info") // info | warning | critical
  relatedType String? @map("related_type")
  relatedId   String?  @map("related_id") @db.Uuid
  isRead     Boolean  @default(false) @map("is_read")
  readAt     DateTime? @map("read_at")
  /// For retryable events (failed sends), the action that should be retried.
  retryAction String? @map("retry_action")
  retryPayload Json?  @map("retry_payload")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([isRead])
  @@index([createdAt(sort: Desc)])
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)

  @@index([pharmacyId])
  @@map("admin_notifications")
}

// ── Pharmacy settings (singleton) ─────────────────────────────

/// Single-row pharmacy configuration editable by admin (location, contact, hours).
/// Public pages fall back to static `app/lib/data.ts` when this row is missing.
model PharmacySettings {
  id              String   @id @default(uuid()) @db.Uuid
  pharmacyId      String    @default("00000000-0000-4000-a000-000000000001") @unique @map("pharmacy_id") @db.Uuid
  displayName     String?  @map("display_name")
  phone           String?
  email           String?
  whatsapp        String?
  addressLine1    String?  @map("address_line1")
  addressLine2    String?  @map("address_line2")
  city            String?
  state           String?
  zip             String?
  country         String?  @default("Kenya")
  /// WGS84 latitude (e.g. -1.286389)
  latitude        Float?
  /// WGS84 longitude (e.g. 36.817223)
  longitude       Float?
  /// Optional Google Place ID for richer maps links
  placeId         String?  @map("place_id")
  /// Optional full iframe embed URL override; otherwise built from lat/lng
  mapsEmbedUrl    String?  @map("maps_embed_url")
  /// Free-form hours JSON: [{ "day": "Monday – Friday", "time": "8:00 AM – 8:00 PM" }, ...]
  hours           Json     @default("[]")
  tagline         String?
  about           String?
  logoUrl         String?  @map("logo_url")
  coverImageUrl   String?  @map("cover_image_url")
  brandPrimary    String?  @map("brand_primary")
  brandAccent     String?  @map("brand_accent")
  social          Json     @default("{}")
  team            Json     @default("[]")
  testimonials    Json     @default("[]")
  faq             Json     @default("[]")
  insurance       Json     @default("[]")
  certifications  Json     @default("[]")
  deliveryNotes   String?  @map("delivery_notes")
  deliveryFeeKes  Decimal? @map("delivery_fee_kes") @db.Decimal(10, 2)
  deliveryRadiusKm Float?  @map("delivery_radius_km")
  careersEmail    String?  @map("careers_email")

  updatedById     String?  @map("updated_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation("PharmacySettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)

  @@map("pharmacy_settings")
}

// ── How do you feel? (symptom triage) ─────────────────────────

enum SymptomSessionStatus {
  active
  monitoring
  escalated
  resolved
  closed
}

enum SymptomSeverity {
  mild
  moderate
  urgent
  emergency
}

enum SymptomFeeling {
  better
  same
  worse
}

/// AI-aided symptom check-in session. Guests use guestKey (localStorage);
/// logged-in customers link via customerId/userId.
model SymptomSession {
  id               String               @id @default(uuid()) @db.Uuid
  pharmacyId      String    @default("00000000-0000-4000-a000-000000000001") @map("pharmacy_id") @db.Uuid
  /// Opaque browser key for guest sessions (stored in localStorage).
  guestKey         String?              @map("guest_key")
  customerId       String?              @map("customer_id") @db.Uuid
  userId           String?              @map("user_id") @db.Uuid
  status           SymptomSessionStatus @default(active)
  /// High-level category chosen on start: headache | stomach | cold_flu | skin | allergy | other
  category         String?
  chiefComplaint   String?              @map("chief_complaint")
  /// Structured Q&A answers collected during triage (JSON object).
  structuredAnswers Json                @default("{}") @map("structured_answers")
  /// AI-generated rolling summary for staff (not a medical diagnosis).
  aiSummary        String?              @map("ai_summary")
  /// Short provisional label e.g. "possible tension headache" — always non-diagnostic wording.
  provisionalLabel String?              @map("provisional_label")
  severity         SymptomSeverity?
  /// Latest self-reported trend from check-ins.
  feelingTrend     SymptomFeeling?      @map("feeling_trend")
  escalatedAt      DateTime?            @map("escalated_at")
  escalatedReason  String?              @map("escalated_reason")
  /// Linked CRM conversation created on escalation (ticket).
  conversationId   String?              @map("conversation_id") @db.Uuid
  /// Linked enquiry ticket for admin enquiries board.
  enquiryId        String?              @map("enquiry_id") @db.Uuid
  lastCheckInAt    DateTime?            @map("last_check_in_at")
  nextCheckInAt    DateTime?            @map("next_check_in_at")
  messageCount     Int                  @default(0) @map("message_count")
  lastMessageAt    DateTime?            @default(now()) @map("last_message_at")
  /// Staff assignment when escalated
  assignedToId     String?              @map("assigned_to") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  customer   CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user       User?            @relation("SymptomSessionUser", fields: [userId], references: [id], onDelete: SetNull)
  messages   SymptomMessage[]
  checkIns   SymptomCheckIn[]

  @@index([guestKey])
  @@index([customerId])
  @@index([status])
  @@index([lastMessageAt(sort: Desc)])
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)

  @@index([pharmacyId])
  @@map("symptom_sessions")
}

model SymptomMessage {
  id         String   @id @default(uuid()) @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  /// user | assistant | staff | system
  role       String
  content    String
  /// Public image URLs attached to this turn (R2).
  imageUrls  String[] @default([]) @map("image_urls")
  /// Staff sender when role = staff
  senderId   String?  @map("sender_id") @db.Uuid
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  session SymptomSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender  User?          @relation("SymptomStaffSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@map("symptom_messages")
}

model SymptomCheckIn {
  id        String         @id @default(uuid()) @db.Uuid
  sessionId String         @map("session_id") @db.Uuid
  feeling   SymptomFeeling
  notes     String?
  /// Optional free-form score 1–10 for how they feel overall
  score     Int?
  createdAt DateTime       @default(now()) @map("created_at")

  session SymptomSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("symptom_check_ins")
}

// ════════════════════════════════════════════════════════════════
// ── Commerce ledger extension (audit §40–§77) ─────────────────────
// Adds first-class PrescriptionFill, InventoryReservation, Refund,
// InventoryAllocation, CommerceEvent, MedicationPriceHistory,
// CashierSession — plus enriched Order/OrderItem financial fields.
// All additive: existing columns + statuses stay untouched so legacy
// rows keep working; new writes populate the new fields.
// ════════════════════════════════════════════════════════════════

enum OrderType {
  OTC_PURCHASE
  PRESCRIPTION_FILL
