model PrescriptionFill {
  id                  String                @id @default(uuid()) @db.Uuid
  pharmacyId      String    @default("00000000-0000-4000-a000-000000000001") @map("pharmacy_id") @db.Uuid
  prescriptionId      String                @map("prescription_id") @db.Uuid
  /// Linked commercial order that paid for this fill (nullable for legacy / dispatched-without-charge).
  orderId             String?               @unique @map("order_id") @db.Uuid
  /// Refill request that triggered this fill, if any.
  refillRequestId     String?               @unique @map("refill_request_id") @db.Uuid
  /// 1-based sequence for human display (per-prescription).
  fillNumber          Int                   @map("fill_number")
  quantity            Int                   @default(1)
  /// Billing unit for this fill (tablet, bottle, pack, etc.) — audit §14.
  billingUnit         BillingUnit?          @default(UNIT) @map("billing_unit")
  /// Snapshot of the price the customer was charged for this fill.
  unitPriceSnapshot   Decimal               @default(0) @map("unit_price_snapshot") @db.Decimal(10, 2)
  discountAmount      Decimal               @default(0) @map("discount_amount") @db.Decimal(10, 2)
  netAmount           Decimal               @default(0) @map("net_amount") @db.Decimal(10, 2)
  /// Snapshot of pharmacy acquisition cost at fill time (for COGS / margin).
  costPriceSnapshot   Decimal               @default(0) @map("cost_price_snapshot") @db.Decimal(10, 2)
  status              PrescriptionFillStatus @default(pending)
  filledAt            DateTime?             @map("filled_at")
  dispatchedAt        DateTime?             @map("dispatched_at")
  collectedAt         DateTime?             @map("collected_at")
  dispensedById       String?               @map("dispensed_by_id") @db.Uuid
  /// Snapshot of medication id at fill time (so renames/deletes don't break history).
  medicationId        String?               @map("medication_id") @db.Uuid
  medicationName      String                @map("medication_name")
  /// Lot/batch ids consumed by this fill (for recall/trace). Stored as JSON array of lot UUIDs.
  lotIds              Json                  @default("[]") @map("lot_ids")
  notes               String?
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  prescription   Prescription   @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  order          Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  refillRequest  RefillRequest? @relation(fields: [refillRequestId], references: [id], onDelete: SetNull)
  dispensedBy    User?          @relation("PrescriptionFillDispenser", fields: [dispensedById], references: [id], onDelete: SetNull)
  medication     PharmacyInventory? @relation(fields: [medicationId], references: [id], onDelete: SetNull)

  @@unique([prescriptionId, fillNumber])
  @@index([prescriptionId])
  @@index([orderId])
  @@index([refillRequestId])
  @@index([status])
  @@index([dispatchedAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)

  @@index([pharmacyId])
  @@map("prescription_fills")
}

model InventoryReservation {
