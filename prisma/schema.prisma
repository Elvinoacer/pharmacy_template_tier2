// ── Vaccination & Preventive Services (8) ─────────────────────
// Pharmacy-based immunisation is jurisdiction-dependent (PPB / MoH in Kenya).
// These models capture administration, screening, consent, AEFI, counselling,
// public-health campaigns, and education — never a substitute for national IIS.

model PharmacyImmunizationPolicy {
  id                            String   @id @default(uuid()) @db.Uuid
  pharmacyId      String    @default("00000000-0000-4000-a000-000000000001") @unique @map("pharmacy_id") @db.Uuid
  enabled                       Boolean  @default(true)
  jurisdiction                  String   @default("Kenya")
  authorizingBody               String   @default("Pharmacy and Poisons Board (PPB) / Ministry of Health") @map("authorizing_body")
  authorizingRegulation         String?  @map("authorizing_regulation")
  supervisingPharmacistRequired Boolean  @default(true) @map("supervising_pharmacist_required")
  observationMinutesDefault     Int      @default(15) @map("observation_minutes_default")
  visRequired                   Boolean  @default(true) @map("vis_required")
  aefiReportingContact          String?  @map("aefi_reporting_contact")
  aefiReportingAuthority        String   @default("PPB / Division of Disease Surveillance and Response") @map("aefi_reporting_authority")
  coldChainNotes                String?  @map("cold_chain_notes")
  publicDisclaimer              String?  @map("public_disclaimer")
  walkInAccepted                Boolean  @default(true) @map("walk_in_accepted")
  paediatricOnSite              Boolean  @default(false) @map("paediatric_on_site")
  updatedById                   String?  @map("updated_by") @db.Uuid
  createdAt                     DateTime @default(now()) @map("created_at")
  updatedAt                     DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation("ImmunizationPolicyUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)

  @@map("pharmacy_immunization_policy")
}

