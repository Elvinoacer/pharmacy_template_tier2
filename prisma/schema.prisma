// Tier 2 — Customer Engagement Platform
// Prisma 7 schema for Aether Pharmacy

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ─────────────────────────────────────────────────────

enum UserRole {
  customer
  caregiver
  pharmacist
  staff
  manager
}

enum UserStatus {
  active
  inactive
  suspended
}

enum Gender {
  female
  male
  other
  prefer_not_to_say
}

enum CommChannel {
  email
  sms
  whatsapp
  phone
}

enum CaregiverStatus {
  active
  revoked
}

enum PrescriptionStatus {
  active
  on_hold
  expired
  discontinued
}

enum RefillStatus {
  submitted
  under_review
  approved
  preparing
  ready_for_pickup
  collected
  cancelled
}

enum PickupPreference {
  pickup
  delivery
}

enum RefillSource {
  website
  portal
  ai
  phone
  whatsapp
  staff
}

enum MessageChannel {
  email
  sms
  whatsapp
  portal
  ai
  system
}

enum ConversationChannel {
  email
  sms
  whatsapp
  portal
  ai
}

enum ConversationStatus {
  open
  pending
  resolved
  closed
}

enum MessageDirection {
  inbound
  outbound
}

enum SenderType {
  customer
  staff
  system
  ai
}

enum MessageStatus {
  draft
  scheduled
  sent
  delivered
  failed
  opened
  clicked
  replied
}

enum NotificationChannel {
  email
  sms
  whatsapp
  push
  in_app
}

enum NotificationStatus {
  pending
  sent
  delivered
  failed
  opened
  clicked
}

enum ReminderType {
  refill
  pickup
  follow_up
  wellness
  birthday
  custom
}

enum ReminderStatus {
  scheduled
  sent
  cancelled
  failed
}

enum CampaignChannel {
  email
  sms
  whatsapp
  multi
}

enum CampaignStatus {
  draft
  scheduled
  sending
  sent
  cancelled
}

enum LoyaltyTier {
  bronze
  silver
  gold
  platinum
}

enum LoyaltyTxType {
  earn
  redeem
  adjust
  referral
  bonus
}

enum DiscountType {
  percent
  fixed
  points
}

enum EnquiryType {
  general
  product_availability
  delivery
  contact
  careers
  other
}

enum EnquiryStatus {
  new
  in_progress
  resolved
  closed
}

enum FeedbackType {
  review
  suggestion
  complaint
  satisfaction
}

enum FeedbackStatus {
  new
  reviewed
  responded
  archived
}

enum AiChannel {
  website
  portal
  whatsapp
}

// ── Auth ──────────────────────────────────────────────────────

model User {
  id               String     @id @default(uuid()) @db.Uuid
  email            String     @unique
  /// Null for OAuth-only accounts (e.g. Google sign-in).
  passwordHash     String?    @map("password_hash")
  /// Google subject (`sub`) when the account is linked to Google.
  googleId         String?    @unique @map("google_id")
  role             UserRole   @default(customer)
  emailVerified    Boolean    @default(false) @map("email_verified")
  phoneVerified    Boolean    @default(false) @map("phone_verified")
  twoFactorEnabled Boolean    @default(false) @map("two_factor_enabled")
  twoFactorSecret  String?    @map("two_factor_secret")
  status           UserStatus @default(active)
  lastLoginAt      DateTime?  @map("last_login_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  sessions            Session[]
  passwordResets      PasswordReset[]
  emailVerifications  EmailVerification[]
  profile             CustomerProfile?
  caregiverLinks      Caregiver[]            @relation("CaregiverUser")
  assignedRefills     RefillRequest[]        @relation("RefillAssignee")
  timelineAsUser      TimelineEvent[]        @relation("TimelineUser")
  timelineCreated     TimelineEvent[]        @relation("TimelineCreator")
  assignedConversations Conversation[]       @relation("ConversationAssignee")
  messagesSent        Message[]
  templatesCreated    MessageTemplate[]     @relation("TemplateCreator")
  templatesUpdated    MessageTemplate[]     @relation("TemplateUpdater")
  notifications       Notification[]
  remindersCreated    Reminder[]
  campaignsCreated    Campaign[]
  loyaltyTxCreated    LoyaltyTransaction[]
  enquiriesAssigned   Enquiry[]              @relation("EnquiryAssignee")
  feedbackResponded   Feedback[]             @relation("FeedbackResponder")
  knowledgeCreated    KnowledgeArticle[]     @relation("KnowledgeCreator")
  knowledgeUpdated    KnowledgeArticle[]     @relation("KnowledgeUpdater")
  aiConversations     AiConversation[]
  auditLogs           AuditLog[]
  customerNotes       CustomerNote[]
  segmentsCreated     Segment[]
  pushDevices         PushDevice[]

  @@map("users")
}

/// Browser/device tokens used by firebase-admin to deliver FCM web push notifications.
/// One user can have multiple devices (desktop, phone, tablet) — we fan out to all of them.
model PushDevice {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// The FCM registration token returned by `getToken()` in the browser.
  token     String   @unique
  /// User-agent so the user can recognise "Chrome on Mac", "iPhone Safari", etc.
  label     String?
  /// Bumped on every /api/push/register call so we can prune stale devices.
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_devices")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

model EmailVerification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verifications")
}

// ── Customers ─────────────────────────────────────────────────

/// Onboarding stage — customer must complete profile before fully accessing the portal.
/// proxy.ts allows /portal/onboarding through; everything else under /portal redirects there
/// until `onboardingCompletedAt` is set.
model CustomerProfile {
  id                      String       @id @default(uuid()) @db.Uuid
  userId                  String       @unique @map("user_id") @db.Uuid
  fullName                String       @map("full_name")
  phone                   String?
  dateOfBirth             DateTime?    @map("date_of_birth") @db.Date
  gender                  Gender?
  addressLine1            String?      @map("address_line1")
  addressLine2            String?      @map("address_line2")
  city                    String?
  state                   String?
  zip                     String?
  preferredCommunication  CommChannel  @default(email) @map("preferred_communication")
  emergencyContactName    String?      @map("emergency_contact_name")
  emergencyContactPhone   String?      @map("emergency_contact_phone")
  preferredBranch         String?      @default("Main Branch") @map("preferred_branch")
  notes                   String?
  tags                    String[]     @default([])
  /// Auto-tagged age segment: infant | child | teen | young_adult | adult | senior
  ageSegment              String?      @map("age_segment")
  /// Marks the moment the customer finished the onboarding wizard. Null = still onboarding.
  onboardingCompletedAt   DateTime?    @map("onboarding_completed_at")
  createdAt               DateTime     @default(now()) @map("created_at")
  updatedAt               DateTime     @updatedAt @map("updated_at")

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferences     CustomerPreference?
  caregivers      Caregiver[]
  prescriptions   Prescription[]
  refillRequests  RefillRequest[]
  timelineEvents  TimelineEvent[]
  segments        CustomerSegment[]
  conversations   Conversation[]
  notifications   Notification[]
  reminders       Reminder[]
  loyaltyAccount  LoyaltyAccount?
  referredLoyalty LoyaltyAccount[]     @relation("LoyaltyReferrer")
  enquiries       Enquiry[]
  feedback        Feedback[]
  aiConversations AiConversation[]
  staffNotes      CustomerNote[]
  adherenceLogs   PrescriptionAdherence[]
  orders          Order[]
  payments        Payment[]

  @@index([ageSegment])
  @@map("customer_profiles")
}

model Caregiver {
  id                            String          @id @default(uuid()) @db.Uuid
  customerId                    String          @map("customer_id") @db.Uuid
  caregiverUserId               String?         @map("caregiver_user_id") @db.Uuid
  caregiverName                 String          @map("caregiver_name")
  caregiverEmail                String?         @map("caregiver_email")
  caregiverPhone                String?         @map("caregiver_phone")
  relationship                  String?
  canRequestRefills             Boolean         @default(true) @map("can_request_refills")
  canReceivePickupNotifications Boolean         @default(true) @map("can_receive_pickup_notifications")
  status                        CaregiverStatus @default(active)
  createdAt                     DateTime        @default(now()) @map("created_at")

  customer      CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  caregiverUser User?           @relation("CaregiverUser", fields: [caregiverUserId], references: [id], onDelete: SetNull)
  invites       CaregiverInvite[]

  @@index([customerId])
  @@map("caregivers")
}

model CustomerPreference {
  id                String   @id @default(uuid()) @db.Uuid
  customerId        String   @unique @map("customer_id") @db.Uuid
  emailEnabled      Boolean  @default(true) @map("email_enabled")
  smsEnabled        Boolean  @default(true) @map("sms_enabled")
  whatsappEnabled   Boolean  @default(true) @map("whatsapp_enabled")
  marketingConsent  Boolean  @default(false) @map("marketing_consent")
  reminderConsent   Boolean  @default(true) @map("reminder_consent")
  birthdayMessages  Boolean  @default(true) @map("birthday_messages")
  updatedAt         DateTime @updatedAt @map("updated_at")

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_preferences")
}

// ── Prescriptions & Refills ───────────────────────────────────

model Prescription {
  id               String             @id @default(uuid()) @db.Uuid
  customerId       String             @map("customer_id") @db.Uuid
  medicineName     String             @map("medicine_name")
  rxReference      String?            @map("rx_reference")
  dosage           String?
  /// Free-text schedule like "1 tablet twice daily after meals". AI uses this to predict refill dates.
  schedule         String?
  quantity         Int?
  /// Days of supply per fill (used to predict next refill date).
  daysSupply       Int?               @map("days_supply")
  refillsRemaining Int?               @default(0) @map("refills_remaining")
  lastFilledAt     DateTime?          @map("last_filled_at") @db.Date
  nextRefillDue    DateTime?          @map("next_refill_due") @db.Date
  /// When the prescription should be terminated (e.g. 6-month course ended).
  endDate          DateTime?          @db.Date
  prescriber       String?
  /// Admin-set price the customer pays per refill (used by payment system).
  unitPrice        Decimal?           @db.Decimal(10, 2) @map("unit_price")
  status           PrescriptionStatus @default(active)
  notes            String?
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  customer       CustomerProfile      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  refillRequests RefillRequest[]
  adherence      PrescriptionAdherence[]

  @@index([customerId])
  @@index([status])
  @@map("prescriptions")
}

model RefillRequest {
  id                String           @id @default(uuid()) @db.Uuid
  customerId        String?          @map("customer_id") @db.Uuid
  prescriptionId    String?          @map("prescription_id") @db.Uuid
  medicineName      String           @map("medicine_name")
  rxReference       String?          @map("rx_reference")
  customerName      String?          @map("customer_name")
  phone             String?
  email             String?
  pickupPreference  PickupPreference @default(pickup) @map("pickup_preference")
  preferredDate     DateTime?        @map("preferred_date") @db.Date
  preferredTime     String?          @map("preferred_time")
  notes             String?
  status            RefillStatus     @default(submitted)
  source            RefillSource     @default(website)
  assignedToId      String?          @map("assigned_to") @db.Uuid
  statusUpdatedAt   DateTime         @default(now()) @map("status_updated_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  customer     CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  prescription Prescription?    @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  assignedTo   User?            @relation("RefillAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([status])
  @@map("refill_requests")
}

// ── CRM Timeline ──────────────────────────────────────────────

model TimelineEvent {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String?  @map("customer_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  eventType   String   @map("event_type")
  title       String
  description String?
  metadata    Json     @default("{}")
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  customer  CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user      User?            @relation("TimelineUser", fields: [userId], references: [id], onDelete: SetNull)
  createdBy User?            @relation("TimelineCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([createdAt(sort: Desc)])
  @@map("timeline_events")
}

// ── Segmentation ──────────────────────────────────────────────

model Segment {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  rules       Json     @default("{}")
  isSystem    Boolean  @default(false) @map("is_system")
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  members   CustomerSegment[]
  campaigns Campaign[]

  @@map("segments")
}

model CustomerSegment {
  customerId String   @map("customer_id") @db.Uuid
  segmentId  String   @map("segment_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  segment  Segment         @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@id([customerId, segmentId])
  @@map("customer_segments")
}

// ── Communication ─────────────────────────────────────────────

model Conversation {
  id            String              @id @default(uuid()) @db.Uuid
  customerId    String?             @map("customer_id") @db.Uuid
  channel       ConversationChannel
  subject       String?
  status        ConversationStatus  @default(open)
  assignedToId  String?             @map("assigned_to") @db.Uuid
  lastMessageAt DateTime?           @default(now()) @map("last_message_at")
  createdAt     DateTime            @default(now()) @map("created_at")

  customer   CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo User?            @relation("ConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   Message[]

  @@map("conversations")
}

model Message {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  direction      MessageDirection
  channel        MessageChannel
  senderType     SenderType       @map("sender_type")
  senderId       String?          @map("sender_id") @db.Uuid
  body           String
  subject        String?
  status         MessageStatus    @default(sent)
  scheduledFor   DateTime?        @map("scheduled_for")
  metadata       Json             @default("{}")
  createdAt      DateTime         @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@map("messages")
}

model MessageTemplate {
  id          String               @id @default(uuid()) @db.Uuid
  name        String
  channel     ConversationChannel
  subject     String?
  body        String
  category    String               @default("general")
  createdById String?              @map("created_by") @db.Uuid
  updatedById String?              @map("updated_by") @db.Uuid
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  createdBy User? @relation("TemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("TemplateUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("message_templates")
}

// ── Notifications & Reminders ─────────────────────────────────

model Notification {
  id          String              @id @default(uuid()) @db.Uuid
  customerId  String?             @map("customer_id") @db.Uuid
  userId      String?             @map("user_id") @db.Uuid
  channel     NotificationChannel
  type        String
  title       String
  body        String
  status      NotificationStatus  @default(pending)
  relatedType String?             @map("related_type")
  relatedId   String?             @map("related_id") @db.Uuid
  /// Full body for modal view (longer than `body`, which is the truncated list preview).
  fullBody    String?             @map("full_body")
  /// Whether the customer has dismissed this notification from their feed.
  deletedAt   DateTime?           @map("deleted_at")
  sentAt      DateTime?           @map("sent_at")
  openedAt    DateTime?           @map("opened_at")
  createdAt   DateTime            @default(now()) @map("created_at")

  customer CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([customerId, deletedAt])
  @@index([userId])
  @@index([status])
  @@map("notifications")
}

model Reminder {
  id           String               @id @default(uuid()) @db.Uuid
  customerId   String               @map("customer_id") @db.Uuid
  type         ReminderType
  title        String
  body         String?
  channel      NotificationChannel  @default(email)
  scheduledFor DateTime             @map("scheduled_for")
  status       ReminderStatus       @default(scheduled)
  relatedType  String?              @map("related_type")
  relatedId    String?              @map("related_id") @db.Uuid
  sentAt       DateTime?            @map("sent_at")
  createdById  String?              @map("created_by") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at")

  customer  CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([scheduledFor])
  @@map("reminders")
}

// ── Campaigns ─────────────────────────────────────────────────

model Campaign {
  id           String          @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  channel      CampaignChannel
  segmentId    String?         @map("segment_id") @db.Uuid
  subject      String?
  body         String
  status       CampaignStatus  @default(draft)
  scheduledFor DateTime?       @map("scheduled_for")
  sentAt       DateTime?       @map("sent_at")
  stats        Json            @default("{\"sent\":0,\"delivered\":0,\"opened\":0,\"clicked\":0,\"replied\":0}")
  createdById  String?         @map("created_by") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  segment   Segment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("campaigns")
}

// ── Loyalty ───────────────────────────────────────────────────

model LoyaltyAccount {
  id              String      @id @default(uuid()) @db.Uuid
  customerId      String      @unique @map("customer_id") @db.Uuid
  points          Int         @default(0)
  tier            LoyaltyTier @default(bronze)
  lifetimePoints  Int         @default(0) @map("lifetime_points")
  referralCode    String?     @unique @map("referral_code")
  referredById    String?     @map("referred_by") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  customer   CustomerProfile      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  referredBy CustomerProfile?     @relation("LoyaltyReferrer", fields: [referredById], references: [id], onDelete: SetNull)
  transactions LoyaltyTransaction[]

  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id          String        @id @default(uuid()) @db.Uuid
  accountId   String        @map("account_id") @db.Uuid
  points      Int
  type        LoyaltyTxType
  description String?
  /// What triggered this transaction: manual | cron | rule:refill_completed | etc.
  source      String?       @default("manual")
  createdById String?       @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")

  account   LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt(sort: Desc)])
  @@map("loyalty_transactions")
}

model Coupon {
  id              String       @id @default(uuid()) @db.Uuid
  code            String       @unique
  description     String?
  discountType    DiscountType @map("discount_type")
  discountValue   Decimal      @map("discount_value") @db.Decimal(10, 2)
  pointsCost      Int          @default(0) @map("points_cost")
  maxRedemptions  Int?         @map("max_redemptions")
  /// Per-customer limit. Default 1 — a customer can't redeem the same coupon multiple times.
  maxRedemptionsPerCustomer Int? @default(1) @map("max_redemptions_per_customer")
  redemptions     Int          @default(0)
  validFrom       DateTime?    @default(now()) @map("valid_from")
  validUntil      DateTime?    @map("valid_until")
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  orderItems OrderItem[]

  @@map("coupons")
}

// ── Enquiries & Feedback ──────────────────────────────────────

model Enquiry {
  id           String        @id @default(uuid()) @db.Uuid
  customerId   String?       @map("customer_id") @db.Uuid
  name         String
  email        String?
  phone        String?
  type         EnquiryType   @default(general)
  subject      String?
  message      String
  status       EnquiryStatus @default(new)
  assignedToId String?       @map("assigned_to") @db.Uuid
  staffNotes   String?       @map("staff_notes")
  source       String?       @default("website")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  customer   CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo User?            @relation("EnquiryAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("enquiries")
}

model Feedback {
  id            String         @id @default(uuid()) @db.Uuid
  customerId    String?        @map("customer_id") @db.Uuid
  name          String?
  email         String?
  rating        Int?
  type          FeedbackType   @default(review)
  title         String?
  body          String
  status        FeedbackStatus @default(new)
  staffResponse String?        @map("staff_response")
  respondedById String?        @map("responded_by") @db.Uuid
  respondedAt   DateTime?      @map("responded_at")
  isPublic      Boolean        @default(false) @map("is_public")
  createdAt     DateTime       @default(now()) @map("created_at")

  customer    CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  respondedBy User?            @relation("FeedbackResponder", fields: [respondedById], references: [id], onDelete: SetNull)

  @@map("feedback")
}

// ── AI Knowledge Base ─────────────────────────────────────────

model KnowledgeArticle {
  id         String   @id @default(uuid()) @db.Uuid
  title      String
  category   String   @default("general")
  content    String
  tags       String[] @default([])
  isApproved Boolean  @default(true) @map("is_approved")
  priority   Int      @default(0)
  createdById String? @map("created_by") @db.Uuid
  updatedById String? @map("updated_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  createdBy User? @relation("KnowledgeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("KnowledgeUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("knowledge_articles")
}

model AiConversation {
  id           String    @id @default(uuid()) @db.Uuid
  customerId   String?   @map("customer_id") @db.Uuid
  userId       String?   @map("user_id") @db.Uuid
  sessionKey   String?   @map("session_key")
  channel      AiChannel @default(website)
  escalated    Boolean   @default(false)
  escalatedAt  DateTime? @map("escalated_at")
  messageCount Int       @default(0) @map("message_count")
  summary      String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  customer CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user     User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages AiMessage[]

  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  role           String
  content        String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("ai_messages")
}

// ── Admin ─────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  details    Json     @default("{}")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model CustomerNote {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  authorId   String?  @map("author_id") @db.Uuid
  body       String
  isPinned   Boolean  @default(false) @map("is_pinned")
  /// Manual ordering for drag-and-drop. Lower = higher in the list. Pinned notes always come first.
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author   User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([customerId, sortOrder])
  @@map("customer_notes")
}

// ── Prescription adherence tracking ───────────────────────────
/// Daily log of whether a customer took their medication. Customers log this from the portal;
/// AI uses it to generate adherence insights and refill-date predictions.
model PrescriptionAdherence {
  id            String   @id @default(uuid()) @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  prescriptionId String  @map("prescription_id") @db.Uuid
  /// Local YYYY-MM-DD of the dose being recorded (no timezone surprises).
  takenOn       DateTime @map("taken_on") @db.Date
  status        String   @default("taken") // taken | missed | skipped | late
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  customer    CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  prescription Prescription    @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@unique([prescriptionId, takenOn])
  @@index([customerId, takenOn])
  @@map("prescription_adherence")
}

// ── Medication catalog (stock + shop) ─────────────────────────
/// Drug catalog. Synced from the pharmacy POS via the /api/integrations/pos/route.ts endpoint
/// (POST guarded by POS_API_KEY). Admins can also create/edit entries directly.
model Medication {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  slug            String   @unique
  sku             String?  @unique
  category        String   @default("general")
  description     String?
  /// Markdown-rendered on the public detail page. Includes uses, dosage, side effects,
  /// contraindications, storage — gives customers a complete picture without staff time.
  indications     String?
  dosage          String?
  sideEffects     String?  @map("side_effects")
  contraindications String?
  storage         String?
  price           Decimal  @default(0) @db.Decimal(10, 2)
  /// If true, customers can buy it OTC without a prescription.
  overTheCounter  Boolean  @default(false) @map("over_the_counter")
  /// If true, shown on the public catalog without login. If false, only logged-in customers see it.
  publicListing   Boolean  @default(false) @map("public_listing")
  prescriptionRequired Boolean @default(true) @map("prescription_required")
  stockQty        Int      @default(0) @map("stock_qty")
  lowStockThreshold Int    @default(10) @map("low_stock_threshold")
  imageUrl        String?  @map("image_url")
  active          Boolean  @default(true)
  /// Last time the POS sync touched this row.
  syncedAt        DateTime? @map("synced_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  orderItems OrderItem[]

  @@index([category])
  @@index([overTheCounter])
  @@index([publicListing])
  @@map("medications")
}

// ── Orders & Payments (POS / OTC / Refills) ──────────────────
/// An order ties together a customer, line items, and a payment. Used for OTC counter sales,
/// refill payments, and the portal shop. Created by staff at the counter, or by customers from the portal.
model Order {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String?  @map("customer_id") @db.Uuid
  /// Where the order originated: counter (staff at POS), portal (customer online), refill (linked to a RefillRequest).
  source       String   @default("counter")
  refillId     String?  @map("refill_id") @db.Uuid
  status       String   @default("pending") // pending | paid | fulfilled | cancelled | waived
  total        Decimal  @default(0) @db.Decimal(10, 2)
  /// Admin can waive the payment — captured here so revenue reports stay accurate.
  waived       Boolean  @default(false)
  waivedReason String?  @map("waived_reason")
  /// If waived = one_time, the customer still pays on subsequent refills. If recurring_until, waived until `waivedUntil`.
  waivedScope  String?  @map("waived_scope") // one_time | recurring_until | recurring_permanent
  waivedUntil  DateTime? @map("waived_until")
  /// Free-text staff notes about this order.
  notes        String?
  servedById   String?  @map("served_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customer  CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items     OrderItem[]
  payments  Payment[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  medicationId String? @map("medication_id") @db.Uuid
  /// Snapshot of the medicine name (so historical orders don't break if the medication is renamed).
  name        String
  quantity    Int      @default(1)
  unitPrice   Decimal  @default(0) @db.Decimal(10, 2)
  /// If the customer used a coupon on this line, the discount applied.
  discountApplied Decimal @default(0) @map("discount_applied") @db.Decimal(10, 2)
  couponId    String?  @map("coupon_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medication Medication? @relation(fields: [medicationId], references: [id], onDelete: SetNull)
  coupon     Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
  waived
}

enum PaymentProvider {
  daraja
  cash
  card
  other
}

model Payment {
  id           String         @id @default(uuid()) @db.Uuid
  orderId      String         @map("order_id") @db.Uuid
  customerId   String?        @map("customer_id") @db.Uuid
  amount       Decimal        @db.Decimal(10, 2)
  provider     PaymentProvider @default(daraja)
  status       PaymentStatus  @default(pending)
  /// Provider reference (Daraja checkout request ID, etc.)
  providerRef  String?        @map("provider_ref")
  /// Phone number used for M-Pesa STK push.
  phone        String?
  failureReason String?       @map("failure_reason")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

// ── Loyalty automation rules ─────────────────────────────────
/// Configurable rules so loyalty points are earned automatically without manual taps.
/// e.g. "Earn 10 points for every completed refill", "Earn 1 point per KES 100 spent".
/// A cron job (or event hook) reads these and credits points accordingly.
model LoyaltyRule {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  trigger     String   // refill_completed | order_paid | first_order | birthday | referral_completed
  points      Int      @default(0)
  /// Optional multiplier: for order_paid, points = floor(amount * multiplier / 100).
  multiplier  Decimal? @db.Decimal(10, 4)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("loyalty_rules")
}

// ── Caregiver invitations ────────────────────────────────────
/// Token-based invite links emailed to a caregiver so they can finish setting up their own account
/// and link back to the patient. One token per invite, single-use, expires in 7 days.
model CaregiverInvite {
  id          String   @id @default(uuid()) @db.Uuid
  caregiverId String   @map("caregiver_id") @db.Uuid
  email       String
  tokenHash   String   @unique @map("token_hash")
  expiresAt   DateTime @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime @default(now()) @map("created_at")

  caregiver Caregiver @relation(fields: [caregiverId], references: [id], onDelete: Cascade)

  @@map("caregiver_invites")
}

// ── Inbound admin notifications ───────────────────────────────
/// A separate model from Notification (which is outbound to customers). AdminNotification is
/// for inbound events the staff team needs to see: new refill, new enquiry, low feedback, etc.
/// Has its own read/unread state, severity, and a `retry` action when applicable.
model AdminNotification {
  id         String   @id @default(uuid()) @db.Uuid
  /// Type of event: refill_new | enquiry_new | feedback_low | ai_escalation | stock_low | payment_failed | campaign_failed | reminder_failed
  type       String
  title      String
  body       String
  severity   String   @default("info") // info | warning | critical
  relatedType String? @map("related_type")
  relatedId   String?  @map("related_id") @db.Uuid
  isRead     Boolean  @default(false) @map("is_read")
  readAt     DateTime? @map("read_at")
  /// For retryable events (failed sends), the action that should be retried.
  retryAction String? @map("retry_action")
  retryPayload Json?  @map("retry_payload")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([isRead])
  @@index([createdAt(sort: Desc)])
  @@map("admin_notifications")
}
