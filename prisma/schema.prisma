model ImmunizationAppointment {
  id               String    @id @default(uuid()) @db.Uuid
  pharmacyId      String    @default("00000000-0000-4000-a000-000000000001") @map("pharmacy_id") @db.Uuid
  vaccineProductId String    @map("vaccine_product_id") @db.Uuid
  customerId       String?   @map("customer_id") @db.Uuid
  serviceBookingId String?   @unique @map("service_booking_id") @db.Uuid
  campaignId       String?   @map("campaign_id") @db.Uuid
  patientName      String    @map("patient_name")
  patientPhone     String    @map("patient_phone")
  patientEmail     String?   @map("patient_email")
  patientDob       DateTime? @map("patient_dob") @db.Date
  patientGender    String?   @map("patient_gender")
  preferredDate    String?   @map("preferred_date")
  preferredTime    String?   @map("preferred_time")
  /// requested | screened | scheduled | checked_in | administered | observed | completed | cancelled | deferred | referred
  status           String    @default("requested")
  /// online | walk_in | campaign | staff | portal
  source           String    @default("online")
  notes            String?
  staffNotes       String?   @map("staff_notes")
  assignedToId     String?   @map("assigned_to") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  vaccine     VaccineProduct           @relation(fields: [vaccineProductId], references: [id], onDelete: Restrict)
  customer    CustomerProfile?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  booking     ServiceBooking?          @relation(fields: [serviceBookingId], references: [id], onDelete: SetNull)
  assignedTo  User?                    @relation("ImmunizationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  screening   PreVaccinationScreening?
  consent     VaccinationConsent?
  record      ImmunizationRecord?

  @@index([status])
  @@index([vaccineProductId])
  @@index([customerId])
  @@index([createdAt(sort: Desc)])
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)

  @@index([pharmacyId])
  @@map("immunization_appointments")
}

model PreVaccinationScreening {
  id                    String   @id @default(uuid()) @db.Uuid
  appointmentId         String   @unique @map("appointment_id") @db.Uuid
  customerId            String?  @map("customer_id") @db.Uuid
  screenedById          String?  @map("screened_by") @db.Uuid
  answers               Json     @default("{}")
  allergyFlag           Boolean  @default(false) @map("allergy_flag")
  pregnancyFlag         Boolean  @default(false) @map("pregnancy_flag")
  immunocompromisedFlag Boolean  @default(false) @map("immunocompromised_flag")
  recentIllnessFlag     Boolean  @default(false) @map("recent_illness_flag")
  previousReactionFlag  Boolean  @default(false) @map("previous_reaction_flag")
  anticoagulantFlag     Boolean  @default(false) @map("anticoagulant_flag")
  /// eligible | defer | refer | contraindicated
  outcome               String   @default("eligible")
  outcomeReason         String?  @map("outcome_reason")
  notes                 String?
  createdAt             DateTime @default(now()) @map("created_at")

  appointment ImmunizationAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customer    CustomerProfile?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  screenedBy  User?                   @relation("VaccinationScreener", fields: [screenedById], references: [id], onDelete: SetNull)

  @@map("pre_vaccination_screenings")
}

model VaccinationConsent {
  id                    String    @id @default(uuid()) @db.Uuid
  appointmentId         String    @unique @map("appointment_id") @db.Uuid
  vaccineProductId      String    @map("vaccine_product_id") @db.Uuid
  customerId            String?   @map("customer_id") @db.Uuid
  visProvided           Boolean   @default(true) @map("vis_provided")
  visVersion            String?   @map("vis_version")
  visProvidedAt         DateTime? @map("vis_provided_at")
  /// self | parent_guardian | caregiver
  consentType           String    @default("self") @map("consent_type")
  consenterName         String    @map("consenter_name")
  consenterRelationship String?   @map("consenter_relationship")
  signatureName         String    @map("signature_name")
  consentTextSnapshot   String    @map("consent_text_snapshot")
  signedAt              DateTime  @default(now()) @map("signed_at")
  withdrawnAt           DateTime? @map("withdrawn_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  appointment ImmunizationAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  vaccine     VaccineProduct          @relation(fields: [vaccineProductId], references: [id], onDelete: Restrict)
  customer    CustomerProfile?        @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@map("vaccination_consents")
}

model ImmunizationRecord {
  id                      String    @id @default(uuid()) @db.Uuid
  appointmentId           String?   @unique @map("appointment_id") @db.Uuid
  vaccineProductId        String    @map("vaccine_product_id") @db.Uuid
  customerId              String?   @map("customer_id") @db.Uuid
  consentId               String?   @map("consent_id") @db.Uuid
  administeredById        String?   @map("administered_by") @db.Uuid
  supervisingPharmacistId String?   @map("supervising_pharmacist_id") @db.Uuid
  patientName             String    @map("patient_name")
  patientDob              DateTime? @map("patient_dob") @db.Date
  patientGender           String?   @map("patient_gender")
  patientPhone            String?   @map("patient_phone")
  doseNumber              Int       @default(1) @map("dose_number")
  seriesComplete          Boolean   @default(true) @map("series_complete")
  administeredAt          DateTime  @default(now()) @map("administered_at")
  route                   String    @default("IM")
  site                    String?
  doseMl                  Decimal?  @map("dose_ml") @db.Decimal(4, 2)
  lotNumber               String    @map("lot_number")
  expiryDate              DateTime? @map("expiry_date") @db.Date
  manufacturer            String?
  visGivenAt              DateTime? @map("vis_given_at")
  visVersion              String?   @map("vis_version")
  observationMinutes      Int       @default(15) @map("observation_minutes")
  observationUntil        DateTime? @map("observation_until")
  /// uneventful | delayed | aefi
  observationOutcome      String    @default("uneventful") @map("observation_outcome")
  nextDueDate             DateTime? @map("next_due_date") @db.Date
  certificateCode         String    @unique @map("certificate_code")
  campaignId              String?   @map("campaign_id") @db.Uuid
  notes                   String?
  /// administered | voided
  status                  String    @default("administered")
  voidReason              String?   @map("void_reason")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  appointment           ImmunizationAppointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  vaccine               VaccineProduct           @relation(fields: [vaccineProductId], references: [id], onDelete: Restrict)
  customer              CustomerProfile?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  administeredBy        User?                    @relation("ImmunizationAdministeredBy", fields: [administeredById], references: [id], onDelete: SetNull)
  supervisingPharmacist User?                    @relation("ImmunizationSupervisor", fields: [supervisingPharmacistId], references: [id], onDelete: SetNull)
  aefiReports           AdverseEventFollowingImmunization[]

  @@index([customerId])
  @@index([vaccineProductId])
  @@index([administeredAt(sort: Desc)])
  @@map("immunization_records")
}

model AdverseEventFollowingImmunization {
  id                  String    @id @default(uuid()) @db.Uuid
  immunizationId      String    @map("immunization_id") @db.Uuid
  onsetAt             DateTime  @map("onset_at")
  /// mild | moderate | severe | life_threatening
  severity            String
  symptoms            String
  actionTaken         String    @map("action_taken")
  /// recovering | recovered | sequela | unknown | fatal
  outcome             String    @default("recovering")
  reportedToAuthority Boolean   @default(false) @map("reported_to_authority")
  reportedAt          DateTime? @map("reported_at")
  reportedById        String?   @map("reported_by") @db.Uuid
  notes               String?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  immunization ImmunizationRecord @relation(fields: [immunizationId], references: [id], onDelete: Cascade)
  reportedBy   User?              @relation("AefiReporter", fields: [reportedById], references: [id], onDelete: SetNull)

  @@index([immunizationId])
  @@index([severity])
  @@map("aefi_reports")
}

model PreventiveCounsellingSession {
  id              String    @id @default(uuid()) @db.Uuid
  pharmacyId      String    @default("00000000-0000-4000-a000-000000000001") @map("pharmacy_id") @db.Uuid
  customerId      String?   @map("customer_id") @db.Uuid
  counsellorId    String?   @map("counsellor_id") @db.Uuid
  campaignId      String?   @map("campaign_id") @db.Uuid
  /// smoking_cessation | weight_management | cardiovascular_risk | diabetes_prevention | travel_health | family_planning | alcohol | nutrition | immunization_education | general_wellness | malaria_prevention | hiv_prevention
  topic           String
  /// in_person | phone | portal
  format          String    @default("in_person")
  durationMinutes Int       @default(20) @map("duration_minutes")
  patientName     String    @map("patient_name")
  patientPhone    String?   @map("patient_phone")
  summary         String?
  goals           String[]  @default([])
  resourcesGiven  String[]  @default([]) @map("resources_given")
  followUpDate    DateTime? @map("follow_up_date") @db.Date
  preferredDate   String?   @map("preferred_date")
  preferredTime   String?   @map("preferred_time")
  /// requested | scheduled | completed | no_show | cancelled
  status          String    @default("scheduled")
  source          String    @default("online")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  customer   CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  counsellor User?            @relation("PreventiveCounsellor", fields: [counsellorId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([topic])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)

  @@index([pharmacyId])
  @@map("preventive_counselling_sessions")
}

model PublicHealthCampaign {
  id                String    @id @default(uuid()) @db.Uuid
  pharmacyId      String    @default("00000000-0000-4000-a000-000000000001") @map("pharmacy_id") @db.Uuid
  campaignId        String?   @unique @map("crm_campaign_id") @db.Uuid
  slug              String
  title             String
  /// vaccination | screening | counselling | education | outbreak
  theme             String
  description       String
  short             String
  startDate         DateTime  @map("start_date") @db.Date
  endDate           DateTime? @map("end_date") @db.Date
  targetPopulation  String    @map("target_population")
  vaccinesOffered   String[]  @default([]) @map("vaccines_offered")
  walkInDays        String?   @map("walk_in_days")
  targetDoses       Int?      @map("target_doses")
  dosesAdministered Int       @default(0) @map("doses_administered")
  educationTopics   String[]  @default([]) @map("education_topics")
  locationNotes     String?   @map("location_notes")
  regulatoryNotes   String?   @map("regulatory_notes")
  heroImage         String?   @map("hero_image")
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  crmCampaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([theme])
  @@index([active])
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)

  @@index([pharmacyId])
  @@unique([pharmacyId, slug])
  @@map("public_health_campaigns")
}

